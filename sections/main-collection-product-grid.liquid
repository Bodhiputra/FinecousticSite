{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- include 'fc-launch-gates' -%}


{%- style -%}

/* ── TOOLBAR ── */


/* ── GRID SWIPE ZONE ── */
.fc-shop-swipe-zone {
  width: 100%;
  display: flex;
  flex-direction: column;
}

.fc-shop-swipe-zone--soon {
  flex: 1;
}

.fc-shop-swipe-zone--soon .fc-grid {
  margin-bottom: 0;
  flex: 0 0 auto;
  width: 100%;
}

.fc-shop-swipe-zone--soon .fc-category-soon {
  margin: 0;
  flex: 0 0 auto;
}

/* ── GRID (breakpoints live in custom-style.css; --fc-product-cols set by JS) ── */

/* ── CARD ── */
.fc-card {
  display: flex;
  flex-direction: column;
  background: transparent;
  cursor: pointer;
  position: relative;
  min-width: 0;
}
.fc-card__image { cursor: pointer; }
.fc-card:hover { background: transparent; }

.fc-card__image {
  width: 100%;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background: transparent;
  position: relative;
}
.fc-card__img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
  display: block;
  transition: transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  transform: scale(1);
}
.fc-card:hover:not(:has(.fc-card__tag:hover, .fc-tag-oos-wrap:hover, .fc-tag-coming-soon-wrap:hover, .fc-tag--launch-locked:hover)) .fc-card__img {
  transform: scale(1.07);
}

/* Speakers — landscape images: contain so nothing gets cropped */
.fc-card[data-category="speakers"] .fc-card__img {
  object-fit: contain;
  object-position: center center;
  transform: scale(0.9);
}
.fc-card[data-category="speakers"]:hover:not(:has(.fc-card__tag:hover, .fc-tag-oos-wrap:hover, .fc-tag-coming-soon-wrap:hover, .fc-tag--launch-locked:hover)) .fc-card__img {
  transform: scale(0.95);
}

/* Product cards — hover image stack only, no IG dot pagination */
.fc-shop-page .fc-card__image .fc-ig-dots,
#fc-collection-header + .fc-ig-dots,
.fc-title-carousel + .fc-ig-dots {
  display: none !important;
}

/* ── HIDDEN CARD STATE ── */
.fc-card.fc-hidden { display: none; }

/* ── FILTER APPEAR ANIMATION ── */
/* ── CATEGORY PLACEHOLDER ── */
.fc-category-soon {
  font-family: var(--fc-font);
  font-size: clamp(18px, 2.5vw, 28px);
  font-weight: 700;
  color: #ffffff;
  text-align: center;
  margin: clamp(48px, 8vw, 96px) auto;
  padding: 0 clamp(20px, 5vw, 50px);
  line-height: 1;
}
.fc-category-soon[hidden] {
  display: none;
}

/* ── PAGINATION ── */
.fc-pagination {
  padding: 40px;
  display: flex;
  justify-content: center;
}

/* ── OVERLAY ── */
.fc-overlay {
  position: fixed;
  inset: 0;
  z-index: 200;
  background: rgba(0,0,0,0.82);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}
.fc-overlay.active { opacity: 1; pointer-events: all; }

/* ── EXPANDED CARD ── */
.fc-expanded {
  position: fixed;
  top: 50%;
  left: 50%;
  z-index: 201;
  width: 680px;
  max-width: 92vw;
  background: #0d0d0d;
  border: 1px solid rgba(255,255,255,0.1);
  display: flex;
  opacity: 0;
  pointer-events: none;
  /* transform set by JS on open */
  will-change: transform, opacity;
}
.fc-expanded.open {
  opacity: 1;
  pointer-events: all;
}

.fc-expanded__image {
  width: 52%;
  flex-shrink: 0;
  background: #0a0a0a;
  overflow: hidden;
  position: relative;
  min-height: 360px;
}
.fc-expanded__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.fc-expanded__info {
  flex: 1;
  padding: 32px 26px 26px;
  display: flex;
  flex-direction: column;
  border-left: 1px solid rgba(255,255,255,0.06);
  position: relative;
  min-height: 360px;
}

.fc-exp-close {
  position: absolute;
  top: 14px;
  right: 14px;
  width: 28px;
  height: 28px;
  background: transparent;
  border: none;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(255,255,255,0.35);
  transition: color 0.15s;
  padding: 0;
}
.fc-exp-close:hover { color: #fff; }
.fc-exp-close svg { width: 13px; height: 13px; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; }

.fc-exp-category {
  font-family: var(--fc-font);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: -0.01em;
  color: var(--fc-yellow);
  margin-bottom: 10px;
}
.fc-exp-name {
  font-family: var(--fc-font);
  font-size: 19px;
  font-weight: 700;
  color: #fff;
  letter-spacing: -0.02em;
  line-height: 1.2;
  margin-bottom: 7px;
}
.fc-exp-price {
  font-family: var(--fc-font);
  font-size: 14px;
  font-weight: 400;
  letter-spacing: -0.02em;
  color: rgba(255,255,255,0.4);
  margin-bottom: 0;
}

/* Color swatches */
.fc-exp-colors {
  margin-top: 22px;
  margin-bottom: auto;
  padding-bottom: 24px;
}
.fc-exp-colors.hidden { display: none; }
.fc-exp-color-label {
  font-family: var(--fc-font);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: -0.01em;
  color: rgba(255,255,255,0.28);
  margin-bottom: 10px;
}
.fc-exp-swatches {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}
.fc-color-swatch {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  border: 2px solid transparent;
  cursor: pointer;
  position: relative;
  transition: border-color 0.15s, transform 0.15s;
  outline: none;
  flex-shrink: 0;
}
.fc-color-swatch:hover { transform: scale(1.1); }
.fc-color-swatch.active::after {
  content: '';
  position: absolute;
  inset: -4px;
  border-radius: 50%;
  border: 1.5px solid rgba(255,255,255,0.5);
}
.fc-color-swatch.unavailable { opacity: 0.35; cursor: not-allowed; }

/* Expanded ATC */
.fc-exp-atc-wrap {
  position: relative;
  height: 44px;
  margin-top: auto;
}
.fc-exp-atc-btn {
  position: absolute;
  inset: 0;
  height: 44px;
  background: #fff;
  color: #000;
  border: none;
  font-family: var(--fc-font);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: -0.02em;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s, opacity 0.2s, transform 0.2s;
  z-index: 2;
  width: 100%;
}
.fc-exp-atc-btn:hover { background: var(--fc-yellow); }
.fc-exp-atc-btn:disabled { opacity: 0.4; cursor: not-allowed; }
.fc-expanded.exp-added .fc-exp-atc-btn { opacity: 0; pointer-events: none; transform: scale(0.95); }

.fc-exp-stepper {
  position: absolute;
  inset: 0;
  height: 44px;
  display: flex;
  align-items: stretch;
  border: 1px solid rgba(255,255,255,0.12);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s 0.05s, transform 0.2s 0.05s;
  transform: scale(0.95);
  z-index: 1;
}
.fc-expanded.exp-added .fc-exp-stepper { opacity: 1; pointer-events: all; transform: scale(1); }
.fc-exp-stepper__btn {
  flex: 0 0 44px;
  background: transparent;
  border: none;
  color: #fff;
  font-size: 18px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s;
  font-family: var(--fc-font);
  line-height: 1;
}
.fc-exp-stepper__btn:hover { background: rgba(255,255,255,0.05); }
.fc-exp-stepper__count {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  font-weight: 700;
  color: #fff;
  border-left: 1px solid rgba(255,255,255,0.1);
  border-right: 1px solid rgba(255,255,255,0.1);
  user-select: none;
}

/* ── RESPONSIVE ── */
@media screen and (max-width: 600px) {
  .fc-expanded { flex-direction: column; }
  .fc-expanded__image { width: 100%; min-height: 220px; }
  .fc-expanded__info { min-height: auto; }
  .fc-filter-pill { font-size: 12px; padding: 0 8px; }
}

{%- endstyle -%}

{%- paginate collection.products by section.settings.products_per_page -%}

{%- comment -%} Embed product data as JSON for JS to consume {%- endcomment -%}
{%- for product in collection.products -%}
  {%- include 'fc-exclude-product', product: product -%}
  {%- if fc_exclude_product -%}{%- continue -%}{%- endif -%}
  {%- render 'fc-product-data', product: product -%}
{%- endfor -%}

<div class="fc-shop-page">
{%- render 'fc-title-carousel',
  id: 'fc-collection',
  labels: 'All Products|Speakers|Microphones|Earphones',
  active_index: 0
-%}

{%- comment -%} Product grid {%- endcomment -%}
<div class="fc-page-swipe-zone fc-shop-swipe-zone" id="fc-shop-swipe-zone">
<div class="fc-grid" id="fc-grid" data-cols="{{ section.settings.columns_desktop }}">
  {%- for product in collection.products -%}
    {%- include 'fc-exclude-product', product: product -%}
    {%- unless fc_exclude_product -%}
    {%- liquid
      comment
        Shop tab category — set Product type in Admin: Earphones, Speakers, or Microphones.
        Empty or other types = visible under "All Products" only.
      endcomment
      assign fc_cat = product.type | downcase | strip
      unless fc_cat == 'earphones' or fc_cat == 'speakers' or fc_cat == 'microphones'
        assign fc_cat = ''
      endunless
      assign fc_variant_id = product.first_available_variant.id | default: product.variants.first.id
      assign fc_card_variant = product.first_available_variant | default: product.variants.first
      assign fc_card_available = product.available
      assign fc_handle_down = product.handle | downcase
      assign fc_preorder_coming_soon = false
      assign fc_launch_locked = false
      if fc_launch_phase != 'launched'
        if fc_handle_down == 'hako-nomad-fbs1' or fc_handle_down == 'hako-nomad-l-fbs2'
          if fc_launch_phase == 'countdown'
            assign fc_launch_locked = true
          else
            assign fc_preorder_coming_soon = true
          endif
        endif
      endif
    -%}
    <div class="fc-card"
      data-product-id="{{ product.id }}"
      data-category="{{ fc_cat }}"
      data-url="{{ product.url }}">

      <div class="fc-card__image">
        {%- if product.featured_image -%}
          {%- if forloop.index <= 4 -%}
            {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'eager', class: 'fc-card__img' }}
          {%- else -%}
            {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'fc-card__img' }}
          {%- endif -%}
        {%- endif -%}
      </div>

      {%- if fc_preorder_coming_soon -%}
      {%- render 'fc-price-tag',
        tag_mode: 'coming_soon',
        title: product.title,
        name_class: '',
        tag_class: ''
      -%}
      {%- elsif fc_launch_locked -%}
      {%- render 'fc-price-tag',
        tag_mode: 'launch_locked',
        variant: fc_card_variant,
        variant_id: fc_variant_id,
        price: product.price,
        compare_at_price: product.compare_at_price,
        price_varies: product.price_varies,
        title: product.title,
        name_class: '',
        tag_class: ''
      -%}
      {%- else -%}
      {%- render 'fc-price-tag',
        variant: fc_card_variant,
        variant_id: fc_variant_id,
        price: product.price,
        compare_at_price: product.compare_at_price,
        price_varies: product.price_varies,
        title: product.title,
        available: fc_card_available,
        name_class: '',
        tag_class: ''
      -%}
      {%- endif -%}

    </div>
    {%- endunless -%}
  {%- endfor -%}
</div>

<p class="fc-category-soon" id="fc-grid-soon" hidden>Soon.</p>
</div>

{%- if paginate.pages > 1 -%}
  <div class="fc-pagination">
    {%- render 'pagination', paginate: paginate, anchor: '' -%}
  </div>
{%- endif -%}
</div>

{%- endpaginate -%}

{%- comment -%} Overlay {%- endcomment -%}
<div class="fc-overlay" id="fc-overlay"></div>

{%- comment -%} Expanded floating card {%- endcomment -%}
<div class="fc-expanded" id="fc-expanded" role="dialog" aria-modal="true" aria-label="Product details">

  <div class="fc-expanded__image" id="fc-exp-image-wrap"></div>

  <div class="fc-expanded__info">
    <button class="fc-exp-close" id="fc-exp-close" type="button" aria-label="Close">
      <svg viewBox="0 0 13 13"><line x1="1" y1="1" x2="12" y2="12"/><line x1="12" y1="1" x2="1" y2="12"/></svg>
    </button>

    <p class="fc-exp-category" id="fc-exp-category"></p>
    <h2 class="fc-exp-name" id="fc-exp-name"></h2>
    <p class="fc-exp-price" id="fc-exp-price"></p>

    <div class="fc-exp-colors hidden" id="fc-exp-colors">
      <p class="fc-exp-color-label">Color — <span id="fc-exp-color-name"></span></p>
      <div class="fc-exp-swatches" id="fc-exp-swatches"></div>
    </div>

    <div class="fc-exp-atc-wrap">
      <button class="fc-exp-atc-btn" id="fc-exp-atc-btn" type="button">Add to Cart</button>
      <div class="fc-exp-stepper" id="fc-exp-stepper" aria-hidden="true">
        <button class="fc-exp-stepper__btn minus" id="fc-exp-minus" type="button" aria-label="Decrease quantity">−</button>
        <span class="fc-exp-stepper__count" id="fc-exp-count">1</span>
        <button class="fc-exp-stepper__btn plus" id="fc-exp-plus" type="button" aria-label="Increase quantity">+</button>
      </div>
    </div>
  </div>

</div>

<script src="{{ 'fc-shop-grid.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:sections.main-collection-product-grid.name",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 16,
      "label": "t:sections.main-collection-product-grid.settings.products_per_page.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.main-collection-product-grid.settings.columns_desktop.label"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "t:sections.main-collection-product-grid.settings.columns_mobile.label",
      "options": [
        { "value": "1", "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__1.label" },
        { "value": "2", "label": "t:sections.main-collection-product-grid.settings.columns_mobile.options__2.label" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_filtering.label"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_sorting.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
