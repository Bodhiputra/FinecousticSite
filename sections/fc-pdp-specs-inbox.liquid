<section class="fc-pdp-specs-inbox fc-pdp-hero fc-pdp-mobile-accordions" id="fc-pdp-specs-inbox-{{ section.id }}">
  <div class="fc-pdp-specs-inbox__mount" data-fc-specs-inbox-mount>
    <div class="fc-pdp-specs-inbox__inner" data-fc-specs-inbox-inner>
      {% render 'fc-pdp-specs-inbox-inner', section: section %}
    </div>
  </div>
</section>

{% stylesheet %}
.fc-pdp-specs-inbox__inner {
  display: flex;
  flex-direction: column;
  gap: 0;
  width: 100%;
  max-width: none;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.fc-pdp-specs-inbox__title,
.fc-pdp-specs-inbox__inbox-title {
  display: none;
}

.fc-pdp-specs-inbox__toggle {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  gap: 8px;
  margin-bottom: 16px;
}

.fc-pdp-specs-inbox__tab {
  font-family: var(--fc-font);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: -0.01em;
  color: rgba(255, 255, 255, 0.55);
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.18);
  border-radius: 999px;
  padding: 8px 14px;
  cursor: pointer;
  transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
}

.fc-pdp-specs-inbox__tab.is-active {
  color: #000000;
  background: var(--fc-yellow);
  border-color: var(--fc-yellow);
}

.fc-pdp-specs-inbox__panel {
  display: none;
}

.fc-pdp-specs-inbox__panel.is-active {
  display: block;
}

.fc-pdp-specs-inbox__table {
  width: 100%;
  border-collapse: collapse;
  font-family: var(--fc-font);
}

.fc-pdp-specs-inbox__table th,
.fc-pdp-specs-inbox__table td {
  padding: 10px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  text-align: left;
  vertical-align: top;
  font-size: 13px;
}

.fc-pdp-specs-inbox__table th {
  width: 44%;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.55);
}

.fc-pdp-specs-inbox__table td {
  font-weight: 500;
  color: rgba(255, 255, 255, 0.85);
}

.fc-pdp-specs-inbox__inbox-hero {
  width: 100%;
  margin-bottom: clamp(12px, 3vw, 20px);
  border-radius: 8px;
  overflow: hidden;
}

.fc-pdp-specs-inbox__inbox-photo {
  width: 100%;
  height: auto;
  display: block;
  object-fit: contain;
}

.fc-pdp-specs-inbox__icons {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-start;
  gap: clamp(10px, 2.5vw, 16px) clamp(16px, 4vw, 24px);
  row-gap: clamp(10px, 2.5vw, 14px);
}

.fc-pdp-specs-inbox__icon {
  width: auto;
  max-width: 100%;
  display: inline-flex;
  flex-direction: row;
  align-items: center;
  text-align: left;
  gap: clamp(6px, 1.5vw, 10px);
  flex: 0 1 auto;
}

.fc-pdp-specs-inbox__icon-frame {
  width: clamp(28px, 7vw, 36px);
  height: clamp(28px, 7vw, 36px);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fc-pdp-specs-inbox__icon-frame img {
  max-width: 100%;
  max-height: 100%;
  width: auto;
  height: auto;
  object-fit: contain;
}

.fc-pdp-specs-inbox__icon-label {
  font-family: var(--fc-font);
  font-size: clamp(12px, 3.2vw, 14px);
  font-weight: 500;
  line-height: 1.3;
  color: rgba(255, 255, 255, 0.6);
  margin: 0;
  white-space: normal;
}

@media screen and (min-width: 990px) {
  .fc-pdp-mobile-accordions {
    display: none !important;
  }
}
{% endstylesheet %}

<script>
(function () {
  function bindExclusiveAccordions(inner) {
    if (!inner || inner.dataset.fcAccExclusiveBound === '1') return;
    inner.dataset.fcAccExclusiveBound = '1';

    inner.querySelectorAll('details.fc-pdp-acc > summary').forEach(function (summary) {
      summary.addEventListener('click', function () {
        var clicked = summary.parentElement;
        /* Close all siblings *before* the browser toggles the clicked one */
        inner.querySelectorAll('details.fc-pdp-acc').forEach(function (other) {
          if (other !== clicked) other.removeAttribute('open');
        });
      });
    });
  }

  function bindSpecTabs(inner) {
    if (!inner || inner.dataset.fcSpecTabsBound === '1') return;
    inner.dataset.fcSpecTabsBound = '1';

    inner.querySelectorAll('[data-spec-tab]').forEach(function (tab) {
      tab.addEventListener('click', function () {
        var target = tab.getAttribute('data-spec-tab');
        inner.querySelectorAll('[data-spec-tab]').forEach(function (btn) {
          var active = btn.getAttribute('data-spec-tab') === target;
          btn.classList.toggle('is-active', active);
          btn.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        inner.querySelectorAll('[data-spec-panel]').forEach(function (panel) {
          panel.classList.toggle('is-active', panel.getAttribute('data-spec-panel') === target);
        });
      });
    });
  }

  function initSpecsInbox() {
    var inner = document.querySelector('#fc-pdp-specs-inbox-{{ section.id }} [data-fc-specs-inbox-inner]')
      || document.querySelector('[data-fc-specs-inbox-inner]');
    bindExclusiveAccordions(inner);
    bindSpecTabs(inner);
  }

  initSpecsInbox();
  document.addEventListener('shopify:section:load', initSpecsInbox);

  function warmLazyImages() {
    var inner = document.querySelector('[data-fc-specs-inbox-inner]');
    if (!inner) return;
    inner.querySelectorAll('img[loading="lazy"]').forEach(function (img) {
      var src = img.currentSrc || img.src;
      if (!src) return;
      var warm = new Image();
      warm.decoding = 'async';
      warm.src = src;
    });
  }

  if (window.requestIdleCallback) {
    requestIdleCallback(warmLazyImages, { timeout: 2500 });
  } else {
    setTimeout(warmLazyImages, 400);
  }
})();
</script>

{% schema %}
{
  "name": "FC PDP Specs In Box",
  "tag": "section",
  "class": "fc-pdp-specs-inbox-section",
  "settings": [
    {
      "type": "text",
      "id": "table_title",
      "label": "Specifications heading",
      "default": "Specifications"
    },
    {
      "type": "text",
      "id": "table1_button_label",
      "label": "Table 1 tab label",
      "default": "Audio & Performance"
    },
    {
      "type": "textarea",
      "id": "specs_table_1",
      "label": "Table 1 rows",
      "info": "One row per line. Format: Label | Value"
    },
    {
      "type": "text",
      "id": "table2_button_label",
      "label": "Table 2 tab label",
      "default": "Battery and Charging"
    },
    {
      "type": "textarea",
      "id": "specs_table_2",
      "label": "Table 2 rows",
      "info": "One row per line. Format: Label | Value"
    },
    {
      "type": "text",
      "id": "inbox_title",
      "label": "In the box heading",
      "default": "In The Box"
    },
    {
      "type": "image_picker",
      "id": "inbox_image",
      "label": "In the box image",
      "info": "Full-width image shown when the In The Box accordion is open. Use instead of icon items for layout-style box shots."
    },
    {
      "type": "text",
      "id": "inbox_asset",
      "label": "In the box asset filename",
      "info": "Theme assets/ file (e.g. GROOVE_OWS_FT21_What_In_The_Box.webp). Used when no inbox image is set above."
    },
    {
      "type": "text",
      "id": "quick_start_guide_url",
      "label": "Quick Start Guide PDF URL"
    }
  ],
  "blocks": [
    {
      "type": "inbox_item",
      "name": "In box item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image"
        },
        {
          "type": "text",
          "id": "icon_asset",
          "label": "Icon asset filename",
          "info": "Theme assets/ file. Used instead of icon image when set."
        },
        {
          "type": "text",
          "id": "icon_text",
          "label": "Label",
          "default": "Item"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FC PDP Specs In Box"
    }
  ]
}
{% endschema %}
