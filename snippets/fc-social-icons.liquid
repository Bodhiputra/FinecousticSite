{% comment %}
  Finecoustic social links — text labels, same order everywhere.
  Accepts:
  - class: {String} extra class on wrapper (optional)
{% endcomment %}

<div class="fc-footer__bottom-social{% if class != blank %} {{ class }}{% endif %}">
  {%- if settings.social_instagram_link != blank -%}
    <a href="{{ settings.social_instagram_link }}" class="fc-footer__bottom-link">Instagram</a>
  {%- endif -%}
  {%- if settings.social_youtube_link != blank -%}
    {%- if settings.social_instagram_link != blank -%}
      <span class="fc-footer__bottom-sep" aria-hidden="true">|</span>
    {%- endif -%}
    <a href="{{ settings.social_youtube_link }}" class="fc-footer__bottom-link">YouTube</a>
  {%- endif -%}
  {%- if settings.social_twitter_link != blank -%}
    {%- if settings.social_instagram_link != blank or settings.social_youtube_link != blank -%}
      <span class="fc-footer__bottom-sep" aria-hidden="true">|</span>
    {%- endif -%}
    <a href="{{ settings.social_twitter_link }}" class="fc-footer__bottom-link">X</a>
  {%- endif -%}
</div>
