{%- style -%}

/* ── HEADER (uses shared .fc-collection-header / .fc-sl-title in custom-style.css) ── */

/* ── STORE GRID (CSS columns — waterfall / masonry, no JS) ── */
.fc-locator-body {
  max-width: 1280px;
  margin: 0 auto;
  padding: 24px var(--fc-page-gutter, clamp(16px, 4vw, 64px)) 0;
  columns: 4;
  column-gap: clamp(16px, 2.5vw, 32px);
}

.fc-locator-card {
  break-inside: avoid;
  -webkit-column-break-inside: avoid;
  page-break-inside: avoid;
  margin-bottom: clamp(16px, 2.5vw, 32px);
  width: 100%;
  box-sizing: border-box;
}

/* ── CARD ── */
.fc-locator-body .fc-locator-card,
a.fc-locator-card,
div.fc-locator-card {
  display: flex;
  flex-direction: column;
  gap: 5px;
  background-color: #111111 !important;
  background-image: none !important;
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  padding: clamp(16px, 3vw, 24px) clamp(18px, 3.5vw, 26px) clamp(18px, 3.5vw, 26px);
  text-decoration: none;
  color: #ffffff;
  -webkit-appearance: none;
  appearance: none;
  transition: transform 0.3s ease, border-color 0.2s ease, background-color 0.2s ease;
  box-sizing: border-box;
  isolation: isolate;
}

@media (prefers-color-scheme: dark) {
  .fc-locator-body .fc-locator-card,
  a.fc-locator-card,
  div.fc-locator-card {
    background-color: #161616 !important;
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.04);
  }
}

.fc-locator-card:hover {
  transform: translateY(-4px);
  border-color: rgba(255, 255, 255, 0.16);
}
.fc-locator-card--tbd {
  opacity: 0.4;
  pointer-events: none;
}

.fc-locator-card-country {
  font-family: var(--fc-font);
  font-size: clamp(11px, 1.5vw, 14px);
  font-weight: 700;
  color: var(--fc-yellow);
  letter-spacing: -0.01em;
  margin: 0 0 4px;
  line-height: 1;
}
.fc-locator-card-name {
  font-family: var(--fc-font);
  font-size: clamp(13px, 2vw, 18px);
  font-weight: 700;
  color: #ffffff;
  letter-spacing: -0.01em;
  line-height: 1.25;
  margin: 0;
}
.fc-locator-card-ig {
  font-family: var(--fc-font);
  font-size: clamp(12px, 1.5vw, 14px);
  font-weight: 700;
  color: rgba(255,255,255,0.38);
  letter-spacing: -0.01em;
  display: inline-flex;
  align-items: center;
  gap: 3px;
  align-self: flex-start;
  border-bottom: 1px solid transparent;
  padding-bottom: 1px;
  margin-top: 6px;
  transition: color 0.2s ease, border-color 0.2s ease;
}
.fc-locator-card:hover .fc-locator-card-ig {
  color: var(--fc-yellow);
  border-color: rgba(255,211,0,0.4);
}
.fc-locator-card-ig-arrow {
  display: inline-block;
  transition: transform 0.15s;
}
.fc-locator-card:hover .fc-locator-card-ig-arrow { transform: translate(2px, -2px); }

.fc-locator-card-tbd {
  font-family: var(--fc-font);
  font-size: 11px;
  font-weight: 700;
  letter-spacing: -0.01em;
  color: rgba(255,255,255,0.25);
  margin-top: 4px;
}

.fc-locator-card-contact {
  margin-top: auto;
  padding-top: 10px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.fc-locator-card-contact-row {
  font-family: var(--fc-font);
  font-size: clamp(11px, 1.4vw, 13px);
  font-weight: 700;
  color: rgba(255, 255, 255, 0.45);
  letter-spacing: -0.01em;
  line-height: 1.45;
  margin: 0;
}
.fc-locator-card-contact-label {
  display: block;
  font-size: clamp(10px, 1.4vw, 13px);
  color: var(--fc-yellow);
  margin-bottom: 3px;
  letter-spacing: -0.01em;
}
.fc-locator-card-contact-row a {
  color: rgba(255, 255, 255, 0.55);
  text-decoration: none;
  border-bottom: 1px solid transparent;
  transition: color 0.2s ease, border-color 0.2s ease;
}
.fc-locator-card-contact-row a:hover {
  color: var(--fc-yellow);
  border-color: rgba(255, 211, 0, 0.4);
}
a.fc-locator-card-ig {
  text-decoration: none;
}

/* ── FOOTER CTA ── */
.fc-locator-footnote {
  max-width: 1280px;
  margin: clamp(16px, 2.5vw, 28px) auto 0;
  padding: clamp(12px, 2vw, 14px) var(--fc-page-gutter, clamp(16px, 4vw, 64px)) clamp(36px, 6vw, 80px);
  text-align: right;
}
.fc-locator-footnote-cta {
  font-family: var(--fc-font);
  font-size: clamp(14px, 2vw, 18px);
  font-weight: 700;
  color: var(--fc-yellow);
  text-decoration: none;
  letter-spacing: -0.01em;
  border-bottom: 1px solid rgba(255,211,0,0.22);
  padding-bottom: 2px;
  transition: border-color 0.2s;
}
.fc-locator-footnote-cta:hover { border-color: var(--fc-yellow); }

/* ── RESPONSIVE ── */
@media (max-width: 1024px) {
  .fc-locator-body { columns: 3; }
}

@media (max-width: 768px) {
  .fc-locator-body { columns: 2; }
}

@media (max-width: 480px) {
  .fc-locator-body { columns: 1; }
}

{%- endstyle -%}

<div class="fc-collection-header">
  <div class="fc-sl-title-viewport">
    <span class="fc-sl-title">Store Locator</span>
  </div>
</div>

<div class="fc-locator-body" id="fc-locator-body">

  {%- comment -%} Sort by country name (A→Z), then store name within same country {%- endcomment -%}
  {%- assign fc_sort_keys = '' -%}
  {%- for block in section.blocks -%}
    {%- if block.type == 'store' and block.settings.name != blank -%}
      {%- assign fc_country_key = block.settings.country | default: '' | downcase | strip -%}
      {%- assign fc_name_key = block.settings.name | downcase | strip -%}
      {%- assign fc_sort_key = fc_country_key | append: '||' | append: fc_name_key -%}
      {%- assign fc_sort_keys = fc_sort_keys | append: fc_sort_key | append: '%%' -%}
    {%- endif -%}
  {%- endfor -%}
  {%- assign fc_sorted_keys = fc_sort_keys | split: '%%' | sort_natural -%}

  {%- for fc_key in fc_sorted_keys -%}
    {%- if fc_key != blank -%}
      {%- assign fc_key_parts = fc_key | split: '||' -%}
      {%- assign fc_sort_country = fc_key_parts | first -%}
      {%- assign fc_sort_name = fc_key_parts | last -%}
      {%- for block in section.blocks -%}
        {%- assign fc_block_country = block.settings.country | default: '' | downcase | strip -%}
        {%- assign fc_block_name = block.settings.name | downcase | strip -%}
        {%- if block.type == 'store' and fc_block_country == fc_sort_country and fc_block_name == fc_sort_name -%}
    {%- assign fc_has_contact = false -%}
    {%- if block.settings.address != blank or block.settings.phone != blank -%}
      {%- assign fc_has_contact = true -%}
    {%- endif -%}
    {%- assign fc_web_label = block.settings.website_label | strip -%}
    {%- if fc_web_label == blank and block.settings.website_url != blank -%}
      {%- assign fc_web_label = block.settings.website_url | remove: 'https://' | remove: 'http://' | remove: 'www.' | split: '/' | first -%}
    {%- endif -%}

    {%- if fc_has_contact -%}
        <div class="fc-locator-card" {{ block.shopify_attributes }}>
          {%- if block.settings.country != blank -%}
            <span class="fc-locator-card-country">{{ block.settings.country | escape }}</span>
          {%- endif -%}
          <span class="fc-locator-card-name">{{ block.settings.name | escape }}</span>
          {%- if block.settings.website_url != blank -%}
            <a class="fc-locator-card-ig" href="{{ block.settings.website_url }}" target="_blank" rel="noopener">
              {{- fc_web_label | escape -}} <span class="fc-locator-card-ig-arrow">↗</span>
            </a>
          {%- endif -%}
          <div class="fc-locator-card-contact">
            {%- if block.settings.address != blank -%}
              <p class="fc-locator-card-contact-row">
                <span class="fc-locator-card-contact-label">Address</span>
                {{ block.settings.address | escape }}
              </p>
            {%- endif -%}
            {%- if block.settings.phone != blank -%}
              <p class="fc-locator-card-contact-row">
                <span class="fc-locator-card-contact-label">Tel</span>
                <a href="tel:{{ block.settings.phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' }}">{{ block.settings.phone | escape }}</a>
              </p>
            {%- endif -%}
          </div>
        </div>
      {%- else -%}
        <a
          class="fc-locator-card"
          href="{{ block.settings.website_url | default: '#' }}"
          target="_blank"
          rel="noopener"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.country != blank -%}
            <span class="fc-locator-card-country">{{ block.settings.country | escape }}</span>
          {%- endif -%}
          <span class="fc-locator-card-name">{{ block.settings.name | escape }}</span>
          {%- if block.settings.website_url != blank -%}
            <span class="fc-locator-card-ig">{{ fc_web_label | escape }} <span class="fc-locator-card-ig-arrow">↗</span></span>
          {%- endif -%}
        </a>
      {%- endif -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endfor -%}

</div>

<div class="fc-locator-footnote">
  {%- assign fc_support_url = pages['support'].url | default: '/pages/support' -%}
  <a href="{{ fc_support_url }}?tab=contact&amp;inquiry=Wholesale+%2F+B2B" class="fc-locator-footnote-cta">{{ section.settings.footnote_cta_label | default: 'Become our partner →' | escape }}</a>
</div>

{% schema %}
{
  "name": "Store Locator",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "footnote_cta_label",
      "label": "Footer CTA label",
      "default": "Become our partner →"
    }
  ],
  "blocks": [
    {
      "type": "store",
      "name": "Store",
      "settings": [
        {
          "type": "text",
          "id": "country_filter",
          "label": "Country filter keyword",
          "info": "Lowercase keyword for search (e.g. indonesia). Defaults to country name."
        },
        {
          "type": "text",
          "id": "country",
          "label": "Country"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Store name"
        },
        {
          "type": "url",
          "id": "website_url",
          "label": "Website URL"
        },
        {
          "type": "text",
          "id": "website_label",
          "label": "Website label",
          "info": "Optional display text. Defaults to the website hostname."
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address",
          "info": "When set, card shows contact details instead of a full-card link."
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Store Locator"
    }
  ]
}
{% endschema %}
