{%- style -%}

/* Block centered in viewport; copy left-aligned inside the block */
.fc-about-page {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: calc(100svh - var(--header-bottom-position, var(--fc-nav-drop-top, 72px)) - clamp(72px, 12vh, 120px));
  box-sizing: border-box;
  padding: clamp(24px, 4vw, 48px) clamp(20px, 5vw, 64px);
}

.fc-about {
  width: 100%;
  max-width: min(680px, 90vw);
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  box-sizing: border-box;
}

#MainContent .fc-about-statement {
  font-family: var(--fc-font);
  font-size: clamp(18px, 3.5vw, 26px);
  font-weight: 700;
  color: var(--fc-text-muted);
  line-height: 1.55;
  letter-spacing: -0.01em;
  width: 100%;
  margin: 0;
  text-align: left;
  text-wrap: pretty;
}

#MainContent .fc-about-statement p {
  text-align: left;
}

#MainContent .fc-about-tagline {
  font-family: var(--fc-font);
  font-size: clamp(18px, 3.5vw, 26px);
  font-weight: 700;
  color: #ffffff;
  line-height: 1.55;
  letter-spacing: -0.02em;
  width: 100%;
  margin: clamp(24px, 4vw, 40px) 0 0;
  text-align: left;
  text-wrap: pretty;
}

@media screen and (max-width: 749px) {
  #MainContent .fc-about-statement,
  #MainContent .fc-about-tagline {
    font-size: 16px;
  }
}

{%- endstyle -%}

<div class="fc-about">

  {%- if section.settings.statement != blank -%}
    <div class="fc-about-statement rte" lang="en">{{ section.settings.statement }}</div>
  {%- endif -%}

  {%- if section.settings.tagline != blank -%}
    <p class="fc-about-tagline" lang="en">{{ section.settings.tagline | escape }}</p>
  {%- endif -%}

</div>

{% schema %}
{
  "name": "About Us",
  "tag": "section",
  "class": "section fc-about-page",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "richtext",
      "id": "statement",
      "label": "Statement",
      "default": "<p>At Finecoustic, we believe audio products are more than devices that produce sound. They are part of the spaces we live in and the routines we experience every day. Our mission is to create products that balance listening experience, visual appeal, and everyday usability, designed for those who appreciate both sound quality and aesthetics.</p>"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Build to be Seen. Meant to be Heard."
    }
  ],
  "presets": [
    {
      "name": "About Us"
    }
  ]
}
{% endschema %}
