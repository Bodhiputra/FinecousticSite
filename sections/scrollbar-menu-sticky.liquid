{% schema %}
{
  "name": "Sticky Product Tabs",
  "max_blocks": 10,
  "settings": [],
  "blocks": [
    {
      "type": "tab_item",
      "name": "Tab Item",
      "settings": [
        {
          "type": "text",
          "id": "tab_label",
          "label": "Tab Label",
          "default": "Description"
        },
        {
          "type": "text",
          "id": "tab_link",
          "label": "Tab Link (Example: #description)",
          "default": "#description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sticky Product Tabs NavBar"
    }
  ]
}
{% endschema %}

<div class="custom-product-tabs-wrapper">
  <ul class="custom-product-tabs">
    {% for block in section.blocks %}
      <li>
        <a href="{{ block.settings.tab_link | escape }}">
          {{ block.settings.tab_label | escape }}
        </a>
      </li>
    {% endfor %}
  </ul>
</div>

<style>
.custom-product-tabs-wrapper {
  width: 100%;
  background: #000000;
  z-index: 2;
  padding: 10px 0 5px 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  transition: all 0.3s ease;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.custom-product-tabs-wrapper.sticky {
  position: fixed;
  top: 57.5px;
  left: 0;
  box-shadow: 0 2px 12px rgba(0, 0, 0, 0.6);
}

@media screen and (max-width: 767px) {
  .custom-product-tabs-wrapper.sticky {
    top: 47.5px;
  }
}

.custom-product-tabs {
  display: flex;
  justify-content: center;
  flex-wrap: nowrap;
  gap: 60px;
  list-style: none;
  margin: 0;
  padding: 0 20px 6px;
  width: max-content;
  min-width: 100%;
  box-sizing: border-box;
}

@media screen and (max-width: 767px) {
  .custom-product-tabs {
    justify-content: flex-start;
    padding-left: 10px;
  }
}

.custom-product-tabs li {
  flex: 0 0 auto;
}

.custom-product-tabs li a {
  font-family: var(--fc-font);
  text-decoration: none;
  color: rgba(255, 255, 255, 0.55);
  font-weight: 500;
  font-size: clamp(13px, 1.4vw, 15px);
  letter-spacing: -0.01em;
  padding-bottom: 2px;
  transition: color 0.3s, border-bottom 0.3s;
  display: inline-block;
}

.custom-product-tabs li a:hover {
  color: #ffffff;
}

.custom-product-tabs li a.active {
  color: #ffffff;
  border-bottom: 2px solid var(--fc-yellow);
}
</style>

<script src="{{ 'fc-scrollbar-menu.js' | asset_url }}" defer></script>
