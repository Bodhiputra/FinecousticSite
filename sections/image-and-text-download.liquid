<div class="fc-dl-page{% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}">

  {%- if section.settings.heading != blank -%}
    <h1 class="fc-dl-page__heading">{{ section.settings.heading | escape }}</h1>
  {%- endif -%}

  {%- render 'fc-product-guide-grid', blocks: section.blocks, block_type: 'Text' -%}

</div>

<script src="{{ 'fc-download-grid.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Product Guide",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Page heading",
      "default": "Product Guide"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom class"
    }
  ],
  "blocks": [
    {
      "type": "Text",
      "name": "Product guide",
      "settings": [
        { "type": "text", "id": "product_handle", "label": "Product handle (e.g. groove-anc-ft20)" },
        { "type": "text", "id": "title", "label": "Product display name" },
        { "type": "text", "id": "download_url", "label": "QSG URL override", "info": "Optional. Set Quick Start Guide URL on the product metafield in Admin; use this only to override." },
        { "type": "image_picker", "id": "image", "label": "Fallback image (if product handle is blank)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Guide"
    }
  ]
}
{% endschema %}
