{%- if tag_mode == 'coming_soon' -%}
<div class="fc-card__tag fc-tag--coming-soon {{ tag_class }}">
  <div class="fc-card__tag-body">
    <span class="fc-tag__status">Coming soon.</span>
    <h3 class="fc-card__name {{ name_class }}">{{ title }}</h3>
  </div>
</div>
{%- elsif tag_mode == 'launch_locked' -%}
<div class="fc-card__tag fc-tag--launch-locked {{ tag_class }}" data-variant-id="{{ variant_id }}" data-fc-launch-locked="true">
  <div class="fc-card__tag-body">
    {%- render 'fc-price-scratch',
      price: price,
      compare_at_price: compare_at_price,
      price_varies: price_varies,
      scratch: 'diagonal'
    -%}
    <h3 class="fc-card__name {{ name_class }}">{{ title }}</h3>
  </div>
  <span class="fc-tag-rip"></span>
  <span class="fc-card__atc-lock" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <rect x="5" y="11" width="14" height="10" rx="1.5" stroke="currentColor" stroke-width="2"/>
      <path d="M8 11V8a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </span>
</div>
{%- elsif available -%}
{%- liquid
  assign fc_tag_qty_max = qty_max
  if fc_tag_qty_max == blank and variant != blank
    capture fc_tag_qty_max
      render 'fc-variant-qty-max', variant: variant
    endcapture
    assign fc_tag_qty_max = fc_tag_qty_max | strip
  endif
-%}
<div class="fc-card__tag {{ tag_class }}" data-variant-id="{{ variant_id }}"{% if fc_tag_qty_max != blank %} data-qty-max="{{ fc_tag_qty_max }}"{% endif %}>
  <div class="fc-card__tag-body">
    {%- unless hide_price -%}
    {%- render 'fc-price-scratch',
      price: price,
      compare_at_price: compare_at_price,
      price_varies: price_varies,
      scratch: 'diagonal'
    -%}
    {%- endunless -%}
    {%- if atc_label != blank -%}
      <span class="fc-card__atc-label">{{ atc_label }}</span>
    {%- endif -%}
    {%- unless hide_name -%}
      <h3 class="fc-card__name {{ name_class }}">{{ title }}</h3>
    {%- endunless -%}
  </div>
  <span class="fc-tag-rip"></span>
  <button class="fc-card__atc-plus" data-variant-id="{{ variant_id }}" type="button" aria-label="Add to cart">
    <span class="fc-qty-label"></span>
  </button>
</div>
{%- else -%}
<div class="fc-tag-oos-wrap {{ tag_class }}">
  <div class="fc-card__tag fc-tag--oos">
    <div class="fc-card__tag-body">
      <span class="fc-card__price">
        {%- render 'fc-price-scratch', price: price, compare_at_price: compare_at_price, scratch: 'diagonal' -%}
      </span>
      <h3 class="fc-card__name {{ name_class }}">{{ title }}</h3>
    </div>
  </div>
  <div class="fc-tag-fragment">
    <span class="fc-tag-fragment__label">Sold Out</span>
  </div>
</div>
{%- endif -%}
