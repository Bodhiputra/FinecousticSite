    },
    {
      "type": "textarea",
      "id": "specs_table_1",
      "label": "Table 1 rows",
      "info": "One row per line. Format: Label | Value"
    },
    {
      "type": "text",
      "id": "table2_button_label",
      "label": "Table 2 tab label",
      "default": "Battery and Charging"
    },
    {
      "type": "textarea",
      "id": "specs_table_2",
      "label": "Table 2 rows",
      "info": "One row per line. Format: Label | Value"
    },
    {
      "type": "header",
      "content": "In the box"
    },
    {
      "type": "text",
