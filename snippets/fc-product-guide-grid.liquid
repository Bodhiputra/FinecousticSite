{% doc %}
  Product guide download grid (QSG links).

  @param {object} blocks - Section blocks to render
  @param {string} [block_type] - Block type to include (default: Text)
  @param {string} [grid_id] - Grid element id (default: fc-dl-grid)
  @param {number} [cols] - Max columns (default: 5)
{% enddoc %}

{%- liquid
  assign guide_block_type = block_type | default: 'Text'
  assign guide_grid_id = grid_id | default: 'fc-dl-grid'
  assign guide_cols = cols | default: 5
-%}

<div class="fc-dl-body">
  <div class="fc-grid fc-dl-grid" id="{{ guide_grid_id }}" data-cols="{{ guide_cols }}">
    {%- assign dl_card_index = 0 -%}
    {%- for block in blocks -%}
      {%- if block.type == guide_block_type -%}
        {%- assign dl_product = all_products[block.settings.product_handle] -%}
        {%- capture fc_qsg_url -%}
          {%- render 'fc-product-qsg-url', product: dl_product, override: block.settings.download_url -%}
        {%- endcapture -%}
        {%- assign fc_qsg_url = fc_qsg_url | strip -%}
        {%- if fc_qsg_url == blank -%}{%- continue -%}{%- endif -%}
        {%- liquid
          assign fc_exclude_product = false
          if dl_product != blank
            assign fc_handle = dl_product.handle | downcase
          elsif block.settings.product_handle != blank
            assign fc_handle = block.settings.product_handle | downcase
          else
            assign fc_handle = ''
          endif
          if fc_handle contains 'sonara-ufm1-test'
            assign fc_exclude_product = true
          endif
        -%}
        {%- if fc_exclude_product -%}{%- continue -%}{%- endif -%}
        {%- assign dl_name = block.settings.title -%}
        {%- if dl_name == blank and dl_product != blank -%}
          {%- assign dl_name = dl_product.title -%}
        {%- endif -%}
        <a
          class="fc-card fc-dl-card"
          href="{{ fc_qsg_url }}"
          target="_blank"
          rel="noopener"
          style="animation-delay: {{ dl_card_index | times: 90 }}ms"
          aria-label="Quick Start Guide — {{ dl_name | escape }}"
          {{ block.shopify_attributes }}
        >
          <div class="fc-card__image">
            {%- if block.settings.product_handle != blank and dl_product != blank and dl_product.featured_image -%}
              {{ dl_product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'fc-card__img fc-img-active', alt: dl_name }}
            {%- elsif block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'fc-card__img fc-img-active', alt: dl_name | escape }}
            {%- endif -%}
          </div>

          {%- if dl_name != blank -%}
            <p class="fc-dl-card-name">{{ dl_name | escape }}</p>
          {%- endif -%}
        </a>
        {%- assign dl_card_index = dl_card_index | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>
