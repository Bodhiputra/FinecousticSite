{%- liquid
  assign fc_tag_product = product | default: fc_tag_product
  assign fc_tag_name = title
  capture fc_purchase_mode_str
    render 'fc-product-purchase-mode', product: fc_tag_product, section_purchase_cta: ''
  endcapture
  assign fc_tag_purchase_mode = fc_purchase_mode_str | strip
  assign fc_tag_coming_soon = false
  if fc_tag_purchase_mode == 'coming_soon'
    assign fc_tag_coming_soon = true
  endif
-%}
{%- if fc_tag_coming_soon -%}
<div
  class="fc-card__tag fc-tag--coming-soon {{ tag_class }}"
  data-variant-id="{{ variant_id }}"
  data-fc-purchase-mode="coming_soon"
  data-fc-purchasable="false"
>
  <div class="fc-card__tag-body fc-tag--coming-soon__main">
    {%- unless hide_price -%}
      {%- render 'fc-price-scratch',
        price: price,
        compare_at_price: compare_at_price,
        price_varies: price_varies,
        scratch: 'diagonal'
      -%}
    {%- endunless -%}
    {%- unless hide_name -%}
      <h3 class="fc-card__name {{ name_class }}">{{ fc_tag_name }}</h3>
    {%- endunless -%}
  </div>
  <span class="fc-card__atc-label fc-tag--coming-soon__status">Coming Soon.</span>
</div>
{%- elsif available -%}
{%- liquid
  assign fc_tag_qty_max = qty_max
  if fc_tag_qty_max == blank and variant != blank
    capture fc_tag_qty_max
      render 'fc-variant-qty-max', variant: variant
    endcapture
    assign fc_tag_qty_max = fc_tag_qty_max | strip
  endif
  assign fc_tag_cart_qty = 0
  if variant_id != blank
    for item in cart.items
      if item.variant_id == variant_id
        assign fc_tag_cart_qty = fc_tag_cart_qty | plus: item.quantity
      endif
    endfor
  endif
-%}
<div class="fc-card__tag{% if fc_tag_cart_qty > 0 %} fc-tag-active{% endif %} {{ tag_class }}" data-variant-id="{{ variant_id }}" data-fc-qty="{{ fc_tag_cart_qty }}"{% if fc_tag_qty_max != blank %} data-qty-max="{{ fc_tag_qty_max }}"{% endif %} data-fc-purchasable="true">
  <div class="fc-card__tag-body">
    {%- unless hide_price -%}
    {%- render 'fc-price-scratch',
      price: price,
      compare_at_price: compare_at_price,
      price_varies: price_varies,
      scratch: 'diagonal'
    -%}
    {%- endunless -%}
    {%- if atc_label != blank -%}
      <span class="fc-card__atc-label">{{ atc_label }}</span>
    {%- endif -%}
    {%- unless hide_name -%}
      <h3 class="fc-card__name {{ name_class }}">{{ fc_tag_name }}</h3>
    {%- endunless -%}
  </div>
  <span class="fc-tag-rip"></span>
  <button class="fc-card__atc-plus{% if fc_tag_cart_qty > 0 %} fc-active{% endif %}" data-variant-id="{{ variant_id }}" type="button" aria-label="Add to cart">
    <span class="fc-qty-label">{% if fc_tag_cart_qty > 0 %}{{ fc_tag_cart_qty }}{% endif %}</span>
  </button>
</div>
{%- else -%}
<div class="fc-tag-oos-wrap {{ tag_class }}">
  <div class="fc-card__tag fc-tag--oos">
    <div class="fc-card__tag-body">
      <span class="fc-card__price">
        {%- render 'fc-price-scratch', price: price, compare_at_price: compare_at_price, scratch: 'diagonal' -%}
      </span>
      <h3 class="fc-card__name {{ name_class }}">{{ fc_tag_name }}</h3>
    </div>
  </div>
  <div class="fc-tag-fragment">
    <span class="fc-tag-fragment__label">Sold Out</span>
  </div>
</div>
{%- endif -%}
