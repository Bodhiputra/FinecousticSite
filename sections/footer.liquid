{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{%- liquid
  assign fc_footer_nav = section.settings.bottom_nav_menu
-%}

{%- style -%}
  html:not(.shopify-design-mode) .fc-footer__newsletter-wrap,
  html:not(.shopify-design-mode) .fc-footer__bottom-links {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 1.5s cubic-bezier(0.22,1,0.36,1), transform 1.5s cubic-bezier(0.22,1,0.36,1);
  }

  html.shopify-design-mode .fc-footer__newsletter-wrap,
  html.shopify-design-mode .fc-footer__bottom-links {
    opacity: 1;
    transform: none;
  }

  @media screen and (max-width: 749px) {
    html:not(.shopify-design-mode) .fc-footer__newsletter-wrap,
    html:not(.shopify-design-mode) .fc-footer__bottom-links {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }


  #shopify-section-{{ section.id }} {
    isolation: isolate;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .footer {
    position: relative;
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
    background-color: transparent !important;
    background-image: none !important;
    overflow: visible;
    isolation: isolate;
    border-top: none !important;
    border-bottom: none !important;
  }

  #shopify-section-{{ section.id }},
  #shopify-section-{{ section.id }} > * {
    border-top: none !important;
    border-bottom: none !important;
  }

  #shopify-section-{{ section.id }} .fc-footer {
    position: relative;
    z-index: 1;
    height: auto;
    min-height: 0;
    max-height: none;
    overflow: visible;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .fc-footer__bottom-links {
    position: relative;
    z-index: 1;
    height: auto;
  }

  .section-{{ section.id }}-padding {
    padding-top: 0;
    padding-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .fc-footer {
      height: auto;
      min-height: 0;
      max-height: none;
    }

    #shopify-section-{{ section.id }} .fc-footer__bottom-links {
      --fc-footer-bar-size: clamp(1.2rem, 3.8vw, 1.4rem);
      --fc-footer-bar-gap: clamp(12px, 2.8vw, 18px);
      grid-template-columns: 1fr;
      grid-template-rows: auto auto auto;
      row-gap: 8px;
      height: auto;
      align-content: start;
    }

    #shopify-section-{{ section.id }} .fc-footer__bottom-nav {
      grid-column: 1;
      grid-row: 1;
      justify-self: center;
      justify-content: center;
      width: 100%;
      flex-wrap: wrap;
      row-gap: 8px;
    }

    #shopify-section-{{ section.id }} .fc-footer__bottom-social {
      grid-column: 1;
      grid-row: 2;
      justify-self: center;
      justify-content: center;
    }

    #shopify-section-{{ section.id }} .fc-footer__bottom-copy {
      grid-column: 1;
      grid-row: 3;
      justify-self: center;
      text-align: center;
    }
  }

  @media screen and (min-width: 750px) {
    .footer {
      margin-top: {{ section.settings.margin_top }}px;
    }
  }

{%- endstyle -%}

<footer class="footer color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="fc-footer page-width">
    {%- if section.settings.newsletter_enable -%}
    <div class="fc-footer__newsletter-wrap">
      {%- render 'fc-newsletter-signup',
        form_id_suffix: section.id,
        layout: 'footer',
        title: section.settings.newsletter_heading,
        body: section.settings.newsletter_body
      -%}
    </div>
    {%- endif -%}
    <div class="fc-footer__bottom-links">
      <nav class="fc-footer__bottom-nav" aria-label="Footer">
        {%- if fc_footer_nav != blank and fc_footer_nav.links.size > 0 -%}
          {%- for link in fc_footer_nav.links -%}
            <a href="{{ link.url }}" class="fc-footer__bottom-link"{% if link.current %} aria-current="page"{% endif %}>
              {{- link.title | escape -}}
            </a>
          {%- endfor -%}
        {%- endif -%}
        {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
          <localization-form data-prevent-hide>
            {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}
              <div>
                <h2 class="visually-hidden" id="FooterCountryLabel">{{ 'localization.country_label' | t }}</h2>
                {%- render 'country-localization', localPosition: 'FooterCountry' -%}
              </div>
            {%- endform -%}
          </localization-form>
        {%- endif -%}
      </nav>
      <span class="fc-footer__bottom-copy">&copy; Finecoustic {{ 'now' | date: '%Y' }}</span>
      {%- if section.settings.show_social -%}
      {%- render 'fc-social-icons' -%}
      {%- endif -%}
    </div>
  </div>
</footer>

<script src="{{ 'fc-footer.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "t:sections.footer.name",
  "settings": [
    {
      "type": "link_list",
      "id": "bottom_nav_menu",
      "label": "Footer links (bottom bar)",
      "info": "Edit link labels and URLs in Online Store → Navigation."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__1.content",
      "info": "t:sections.footer.settings.header__1.info"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "default": true,
      "label": "t:sections.footer.settings.newsletter_enable.label"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "default": "Tune in with us.",
      "label": "Newsletter heading"
    },
    {
      "type": "textarea",
      "id": "newsletter_body",
      "default": "Get early updates about products, exclusive offers, and upcoming projects from Finecoustic.",
      "label": "Newsletter body"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": true,
      "label": "t:sections.footer.settings.show_social.label",
      "info": "t:sections.footer.settings.show_social.info"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": true,
      "label": "t:sections.footer.settings.enable_country_selector.label",
      "info": "t:sections.footer.settings.enable_country_selector.info"
    },
    {
      "type": "header",
      "content": "t:sections.all.spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.footer.settings.margin_top.label",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    }
  ]
}
{% endschema %}
