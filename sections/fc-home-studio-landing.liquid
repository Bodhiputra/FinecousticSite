{%- liquid
  assign fc_alt = section.settings.image_alt | default: 'Hako Studio bookshelf speakers'
  assign fc_bg = section.settings.image
  assign fc_asset = section.settings.image_asset | strip
  if fc_asset == blank and fc_bg == blank
    assign fc_asset = 'studio-landing.png'
  endif
  assign fc_pos_x = section.settings.image_position_x
  assign fc_pos_y = section.settings.image_position_y
  assign fc_product = section.settings.featured_product
  assign fc_cta_url = section.settings.button_link
  if fc_cta_url == blank and fc_product != blank
    assign fc_cta_url = fc_product.url
  endif
  if fc_cta_url == blank
    assign fc_fallback_product = all_products['hako-studio-301']
    if fc_fallback_product != blank
      assign fc_cta_url = fc_fallback_product.url
    else
      assign fc_cta_url = '/products/hako-studio-301'
    endif
  endif
  assign fc_cta_label = section.settings.button_label | default: 'Elevate Your Creative Space.'
  assign fc_title_left = section.settings.title_left | strip
  assign fc_title_model_a = section.settings.title_model_a | strip
  assign fc_title_model_b = section.settings.title_model_b | strip
  assign fc_title_a11y = section.settings.title_accessible | strip
  if fc_title_a11y == blank
    assign fc_title_a11y = fc_title_left
    if fc_title_model_a != blank and fc_title_model_b != blank
      assign fc_title_a11y = fc_title_a11y | append: ' ' | append: fc_title_model_a | append: ' and ' | append: fc_title_model_b
    endif
  endif
-%}

<section
  class="fc-home-studio-landing"
  id="fc-home-studio-landing-{{ section.id }}"
  aria-label="{{ fc_alt | escape }}"
  style="
    --fc-home-studio-landing-min-h: {{ section.settings.min_height_vh }}svh;
    --fc-home-studio-landing-bg-pos: {{ fc_pos_x }}% {{ fc_pos_y }}%;
    --fc-home-studio-landing-cta-bottom: {{ section.settings.button_offset_bottom }}px;
    --fc-home-studio-landing-cta-max-w: {{ section.settings.button_max_width }}px;
    --fc-home-studio-landing-title-pl: {{ section.settings.title_padding_left }}px;
    --fc-home-studio-landing-title-pr: {{ section.settings.title_padding_right }}px;
  "
>
  {%- if fc_bg != blank -%}
    {{
      fc_bg
      | image_url: width: 3840
      | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        sizes: '100vw',
        widths: '800, 1200, 1600, 2048, 2560, 3200, 3840',
        alt: fc_alt,
        class: 'fc-home-studio-landing__img'
    }}
  {%- elsif fc_asset != blank -%}
    <img
      class="fc-home-studio-landing__img"
      src="{{ fc_asset | asset_url }}"
      alt="{{ fc_alt | escape }}"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      width="4320"
      height="2400"
    >
  {%- endif -%}

  {%- if section.settings.show_title and fc_title_left != blank -%}
    <div class="fc-home-studio-landing__title-wrap">
      <h2 class="fc-home-studio-landing__title fc-home-studio-landing__title--split" aria-label="{{ fc_title_a11y | escape }}">
        <span class="fc-home-studio-landing__title-part fc-home-studio-landing__title-part--start">{{ fc_title_left | escape }}</span>
        {%- if fc_title_model_a != blank or fc_title_model_b != blank -%}
          <span class="fc-home-studio-landing__title-part fc-home-studio-landing__title-part--end">
            {%- if fc_title_model_a != blank -%}
              <span class="fc-home-studio-landing__title-model">{{ fc_title_model_a | escape }}</span>
            {%- endif -%}
            {%- if fc_title_model_a != blank and fc_title_model_b != blank -%}
              <span class="fc-home-studio-landing__title-pipe" aria-hidden="true">|</span>
            {%- endif -%}
            {%- if fc_title_model_b != blank -%}
              <span class="fc-home-studio-landing__title-model">{{ fc_title_model_b | escape }}</span>
            {%- endif -%}
          </span>
        {%- endif -%}
      </h2>
    </div>
  {%- endif -%}

  {%- if section.settings.show_cta and fc_cta_label != blank and fc_cta_url != blank -%}
    <div class="fc-home-studio-landing__cta-wrap">
      <a class="fc-home-studio-landing__cta" href="{{ fc_cta_url }}">
        {{ fc_cta_label | escape }}
      </a>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
.fc-home-studio-landing-section.shopify-section {
  width: 100%;
  max-width: none;
  min-height: 0;
  padding: 0;
  margin: 0;
  overflow: hidden;
}

.fc-home-studio-landing {
  box-sizing: border-box;
  position: relative;
  display: block;
  width: 100vw;
  max-width: 100vw;
  margin-left: calc(50% - 50vw);
  margin-right: calc(50% - 50vw);
  height: var(--fc-home-studio-landing-min-h, 100svh);
  height: var(--fc-home-studio-landing-min-h, 100dvh);
  max-height: var(--fc-home-studio-landing-min-h, 100svh);
  max-height: var(--fc-home-studio-landing-min-h, 100dvh);
  padding: 0;
  overflow: hidden;
  background: #000000;
  contain: layout style;
}

.fc-home-studio-landing__title-wrap {
  position: absolute;
  inset: 0;
  z-index: 1;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding-left: var(--fc-home-studio-landing-title-pl, clamp(24px, 10vw, 150px));
  padding-right: var(--fc-home-studio-landing-title-pr, clamp(24px, 12vw, 180px));
  pointer-events: none;
}

.fc-home-studio-landing__title {
  margin: 0;
  width: 100%;
  max-width: 100%;
  font-family: var(--fc-font, sans-serif);
  font-size: clamp(32px, 4.44vw, 64px);
  font-weight: 700;
  line-height: 1;
  letter-spacing: 0;
  text-align: center;
  color: #fff;
  text-shadow: 0 1px 12px rgba(0, 0, 0, 0.45);
}

.fc-home-studio-landing__title--split {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: clamp(16px, 3vw, 32px);
  text-align: initial;
}

.fc-home-studio-landing__title-part {
  flex: 0 1 auto;
  min-width: 0;
}

.fc-home-studio-landing__title-part--start {
  margin-right: auto;
  text-align: left;
  white-space: nowrap;
  letter-spacing: -0.06em;
}

.fc-home-studio-landing__title-part--end {
  margin-left: auto;
  display: inline-flex;
  align-items: center;
  justify-content: flex-end;
  gap: clamp(10px, 1.4vw, 18px);
  text-align: right;
  white-space: nowrap;
  font-family: var(--fc-font, 'Alte Haas Grotesk', sans-serif);
  font-weight: 400;
  font-style: normal;
}

.fc-home-studio-landing__title-model {
  font-weight: 400;
  letter-spacing: -0.06em;
}

.fc-home-studio-landing__title-pipe {
  color: var(--fc-yellow, #ffd300);
  font-family: inherit;
  font-weight: 400;
  font-size: 1em;
  line-height: 1;
  user-select: none;
}

.fc-home-studio-landing__img {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  max-width: none;
  object-fit: cover;
  object-position: var(--fc-home-studio-landing-bg-pos, center 80%);
}

.fc-home-studio-landing__cta-wrap {
  position: absolute;
  z-index: 2;
  left: 50%;
  bottom: var(--fc-home-studio-landing-cta-bottom, clamp(40px, 7.5svh, 88px));
  transform: translateX(-50%);
  width: auto;
  max-width: calc(100% - clamp(32px, 6vw, 64px));
  box-sizing: border-box;
  pointer-events: none;
  display: flex;
  justify-content: center;
}

.fc-home-studio-landing__cta {
  pointer-events: auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: auto;
  max-width: min(var(--fc-home-studio-landing-cta-max-w, 704px), 100%);
  min-height: 0;
  height: auto;
  padding: 11px 28px;
  border: 1px solid var(--fc-yellow, #ffd300);
  border-radius: 5px;
  background: transparent;
  color: #fff;
  font-family: var(--fc-font, sans-serif);
  font-size: clamp(13px, 1.25vw, 16px);
  font-weight: 400;
  letter-spacing: 0.02em;
  line-height: 1.25;
  text-align: center;
  text-decoration: none;
  cursor: pointer;
  white-space: nowrap;
  transition:
    background-color 0.2s ease,
    border-color 0.2s ease,
    color 0.2s ease,
    transform 0.18s ease;
}

.fc-home-studio-landing__cta:hover {
  background: #ffd300;
  border-color: #ffd300;
  color: #000;
}

.fc-home-studio-landing__cta:active {
  transform: scale(0.99);
}

.fc-home-studio-landing__cta:focus-visible {
  outline: 2px solid var(--fc-yellow, #ffd300);
  outline-offset: 3px;
}

@media screen and (min-width: 750px) {
  .fc-home-studio-landing__title {
    font-size: 64px;
  }

  .fc-home-studio-landing__title-part--start {
    letter-spacing: -0.07em;
  }

  .fc-home-studio-landing__title-model {
    letter-spacing: -0.06em;
  }
}

@media screen and (max-width: 749px) {
  .fc-home-studio-landing__img {
    object-position: var(--fc-home-studio-landing-bg-pos, 50% 78%);
  }

  .fc-home-studio-landing__title {
    font-size: clamp(28px, 8vw, 40px);
  }

  .fc-home-studio-landing__title-part--start {
    letter-spacing: -0.05em;
  }

  .fc-home-studio-landing__title--split {
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .fc-home-studio-landing__title-part--start,
  .fc-home-studio-landing__title-part--end {
    margin: 0;
    text-align: center;
    justify-content: center;
  }

  .fc-home-studio-landing__cta {
    padding: 10px 22px;
    font-size: clamp(12px, 3.2vw, 14px);
    white-space: normal;
    text-align: center;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Home Studio landing",
  "tag": "section",
  "class": "fc-home-studio-landing-section fc-section--flush-top",
  "settings": [
    {
      "type": "paragraph",
      "content": "Full-width Studio landing hero (Figma 13963:215). Uses theme asset studio-landing.png when no image is uploaded."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image (optional — overrides theme asset)"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Hero theme asset filename",
      "default": "studio-landing.png"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Hako Studio bookshelf speakers"
    },
    {
      "type": "header",
      "content": "Hero title (Figma 13963:215)"
    },
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show title overlay",
      "default": true,
      "info": "Live HTML over the art — use a background export without baked-in type when possible."
    },
    {
      "type": "text",
      "id": "title_left",
      "label": "Title — left",
      "default": "Hako Studio"
    },
    {
      "type": "text",
      "id": "title_model_a",
      "label": "Title — right (first model)",
      "default": "301"
    },
    {
      "type": "text",
      "id": "title_model_b",
      "label": "Title — right (second model)",
      "default": "302"
    },
    {
      "type": "text",
      "id": "title_accessible",
      "label": "Accessible title",
      "default": "Hako Studio 301 and 302",
      "info": "Screen readers only."
    },
    {
      "type": "range",
      "id": "title_padding_left",
      "label": "Title inset — left",
      "min": 0,
      "max": 240,
      "step": 5,
      "unit": "px",
      "default": 150
    },
    {
      "type": "range",
      "id": "title_padding_right",
      "label": "Title inset — right",
      "min": 0,
      "max": 240,
      "step": 5,
      "unit": "px",
      "default": 180
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show CTA button",
      "default": true
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "CTA product",
      "info": "Button links to this product when no custom link is set."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Elevate Your Creative Space."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link override",
      "info": "Optional. Defaults to the selected product URL."
    },
    {
      "type": "range",
      "id": "button_offset_bottom",
      "label": "Button offset from bottom",
      "min": 32,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 56,
      "info": "Distance from bottom of viewport to CTA box."
    },
    {
      "type": "range",
      "id": "button_max_width",
      "label": "CTA box max width",
      "min": 320,
      "max": 880,
      "step": 8,
      "unit": "px",
      "default": 704,
      "info": "Figma desktop frame ~704px wide outline button."
    },
    {
      "type": "range",
      "id": "min_height_vh",
      "label": "Minimum height (vh)",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 100
    },
    {
      "type": "range",
      "id": "image_position_x",
      "label": "Image focus — horizontal",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "image_position_y",
      "label": "Image focus — vertical",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 80,
      "info": "Higher % shows more of the bottom of the art (speakers)."
    }
  ],
  "presets": [
    {
      "name": "Home Studio landing"
    }
  ]
}
{% endschema %}
