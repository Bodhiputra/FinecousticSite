{%- include 'fc-launch-gates' -%}
{%- unless fc_launch_phase == 'countdown' -%}
  {%- comment -%}Only visible between pre-order close and product launch.{%- endcomment -%}
{%- else -%}
  {{ 'fc-nomad-video-duo.css' | asset_url | stylesheet_tag }}

  {%- liquid
    assign fbs1_product = all_products[section.settings.product_handle_fbs1]
    assign fbs2_product = all_products[section.settings.product_handle_fbs2]
    assign fbs1_url = fbs1_product.url | default: '/products/hako-nomad-fbs1'
    assign fbs2_url = fbs2_product.url | default: '/products/hako-nomad-l-fbs2'
    if section.settings.link_fbs1 != blank
      assign fbs1_url = section.settings.link_fbs1
    endif
    if section.settings.link_fbs2 != blank
      assign fbs2_url = section.settings.link_fbs2
    endif
    assign label_fbs1 = section.settings.label_fbs1 | default: 'Hako Nomad'
    assign label_fbs2 = section.settings.label_fbs2 | default: 'Hako Nomad L'
  -%}

  <section
    class="fc-nomad-video-duo"
    id="fc-nomad-video-duo-{{ section.id }}"
    data-section-id="{{ section.id }}"
  >
    <div class="fc-nomad-video-duo__grid">
      <a class="fc-nomad-video-duo__panel" href="{{ fbs1_url }}" aria-label="{{ label_fbs1 | escape }}">
        <div class="fc-nomad-video-duo__media">
          {%- if section.settings.video_fbs1 != blank -%}
            {{ section.settings.video_fbs1 | video_tag:
              class: 'fc-nomad-video-duo__video',
              autoplay: true,
              loop: true,
              muted: true,
              playsinline: true,
              controls: false,
              preload: 'metadata'
            }}
          {%- elsif section.settings.video_fbs1_url != blank -%}
            <video
              class="fc-nomad-video-duo__video"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
            >
              <source src="{{ section.settings.video_fbs1_url | escape }}" type="video/mp4">
            </video>
          {%- else -%}
            <div class="fc-nomad-video-duo__placeholder" aria-hidden="true"></div>
          {%- endif -%}
        </div>
        <span class="fc-nomad-video-duo__label">{{ label_fbs1 | escape }}</span>
      </a>

      <a class="fc-nomad-video-duo__panel" href="{{ fbs2_url }}" aria-label="{{ label_fbs2 | escape }}">
        <div class="fc-nomad-video-duo__media">
          {%- if section.settings.video_fbs2 != blank -%}
            {{ section.settings.video_fbs2 | video_tag:
              class: 'fc-nomad-video-duo__video',
              autoplay: true,
              loop: true,
              muted: true,
              playsinline: true,
              controls: false,
              preload: 'metadata'
            }}
          {%- elsif section.settings.video_fbs2_url != blank -%}
            <video
              class="fc-nomad-video-duo__video"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
            >
              <source src="{{ section.settings.video_fbs2_url | escape }}" type="video/mp4">
            </video>
          {%- else -%}
            <div class="fc-nomad-video-duo__placeholder" aria-hidden="true"></div>
          {%- endif -%}
        </div>
        <span class="fc-nomad-video-duo__label">{{ label_fbs2 | escape }}</span>
      </a>
    </div>
  </section>
{%- endunless -%}

{% schema %}
{
  "name": "Nomad video duo",
  "tag": "section",
  "class": "fc-nomad-video-duo-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shown only during the drop countdown phase (after pre-order closes, before launch). Add MP4 URLs from Shopify Files or pick uploaded videos."
    },
    {
      "type": "video",
      "id": "video_fbs1",
      "label": "FBS1 video (Shopify Files)"
    },
    {
      "type": "text",
      "id": "video_fbs1_url",
      "label": "FBS1 video URL override",
      "info": "Use if video is hosted via CDN URL instead of the picker above."
    },
    {
      "type": "text",
      "id": "product_handle_fbs1",
      "label": "FBS1 product handle",
      "default": "hako-nomad-fbs1"
    },
    {
      "type": "url",
      "id": "link_fbs1",
      "label": "FBS1 link override"
    },
    {
      "type": "text",
      "id": "label_fbs1",
      "label": "FBS1 label",
      "default": "Hako Nomad"
    },
    {
      "type": "video",
      "id": "video_fbs2",
      "label": "FBS2 video (Shopify Files)"
    },
    {
      "type": "text",
      "id": "video_fbs2_url",
      "label": "FBS2 video URL override"
    },
    {
      "type": "text",
      "id": "product_handle_fbs2",
      "label": "FBS2 product handle",
      "default": "hako-nomad-l-fbs2"
    },
    {
      "type": "url",
      "id": "link_fbs2",
      "label": "FBS2 link override"
    },
    {
      "type": "text",
      "id": "label_fbs2",
      "label": "FBS2 label",
      "default": "Hako Nomad L"
    }
  ],
  "presets": [
    {
      "name": "Nomad video duo"
    }
  ]
}
{% endschema %}
