{%- liquid
  if section.settings.hero_image != blank
    assign hero_img = section.settings.hero_image
    assign hero_is_asset = false
  else
    assign hero_is_asset = true
  endif

  if section.settings.hero_image_mobile != blank
    assign hero_img_mobile = section.settings.hero_image_mobile
  elsif hero_is_asset == false
    assign hero_img_mobile = hero_img
  endif

  assign featured_product = section.settings.featured_product
  assign discover_url = section.settings.discover_more_url
  if discover_url == blank and featured_product != blank
    assign discover_url = featured_product.url
  endif

  assign product_title = section.settings.product_title | default: featured_product.title | default: 'Hako Nomad'
  assign title_parts = product_title | split: ' '
  assign title_left = title_parts[0] | default: 'Hako'
  assign title_right = title_parts[1] | default: 'Nomad'
  assign discover_label = section.settings.discover_more_label | default: 'Discover More'
  assign availability_copy = section.settings.availability_text | default: 'Ready to fit in your space.'
-%}

<section
  class="website-hero"
  id="website-hero-{{ section.id }}"
>
  <picture class="website-hero__picture">
    {%- if hero_is_asset -%}
      <source
        media="(min-width: 750px)"
        srcset="{{ 'WebsiteHeroNomad.webp' | asset_url }}"
      >
      <img
        class="website-hero__img"
        src="{{ 'WebsiteHeroNomad-Mobile.webp' | asset_url }}"
        alt="{{ section.settings.image_alt | escape }}"
        width="750"
        height="1000"
        loading="eager"
        fetchpriority="high"
      >
    {%- else -%}
      <source
        media="(min-width: 750px)"
        srcset="
          {{ hero_img | image_url: width: 1100 }} 1100w,
          {{ hero_img | image_url: width: 1500 }} 1500w,
          {{ hero_img | image_url: width: 2000 }} 2000w,
          {{ hero_img | image_url: width: 2560 }} 2560w
        "
        sizes="100vw"
      >
      {{- hero_img_mobile | image_url: width: 1100 | image_tag:
        class: 'website-hero__img',
        loading: 'eager',
        fetchpriority: 'high',
        widths: '375, 550, 750, 1100',
        sizes: '100vw',
        alt: section.settings.image_alt
      -}}
    {%- endif -%}
  </picture>

  {%- if section.settings.show_overlay -%}
    <div class="website-hero__overlay" aria-hidden="true"></div>
  {%- endif -%}

  {%- liquid
    assign hero_subheading = section.settings.hero_subheading | strip
  -%}
  {%- if section.settings.heading != blank or hero_subheading != blank or section.settings.button_label != blank -%}
    <div class="website-hero__content">
      {%- if section.settings.heading != blank -%}
        {%- liquid
          assign heading_highlight = section.settings.heading_highlight | strip
          assign heading_prefix = section.settings.heading
          if heading_highlight != blank
            assign heading_prefix = section.settings.heading | replace: heading_highlight, '' | strip
          endif
        -%}
        <h1 class="website-hero__heading">
          {%- if heading_highlight != blank -%}
            {%- if heading_prefix != blank -%}{{ heading_prefix | escape }} {%- endif -%}
            <span class="website-hero__heading-accent">{{ heading_highlight | escape }}</span>
          {%- else -%}
            {{ section.settings.heading | escape }}
          {%- endif -%}
        </h1>
      {%- endif -%}
      {%- if hero_subheading != blank -%}
        <p class="website-hero__subheading">{{ hero_subheading | escape }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a href="{{ section.settings.button_link }}" class="website-hero__cta">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.settings.show_product_cta -%}
    <div class="website-hero__product-title website-hero__product-title--desktop">
      <div class="website-hero__product-title-inner">
        <h2 class="website-hero__product-title-part">{{ title_left | escape }}</h2>
        <h2 class="website-hero__product-title-part">{{ title_right | escape }}</h2>
      </div>
    </div>
    <div class="website-hero__product-stack">
      <div class="website-hero__product-title website-hero__product-title--mobile">
        <div class="website-hero__product-title-inner">
          <h2 class="website-hero__product-title-part">{{ title_left | escape }}</h2>
          <h2 class="website-hero__product-title-part">{{ title_right | escape }}</h2>
        </div>
      </div>
      <div class="website-hero__product-cta">
        <p class="website-hero__available-copy">{{ availability_copy | escape }}</p>
        {%- if discover_url != blank -%}
          <a class="website-hero__discover-more" href="{{ discover_url }}">
            {{ discover_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
.section-website-hero.shopify-section {
  width: 100%;
  min-height: 100svh;
  min-height: 100dvh;
  padding: 0;
  margin: 0;
}

.website-hero {
  position: relative;
  width: 100%;
  min-height: 100svh;
  min-height: 100dvh;
  overflow: hidden;
  background: #0a0a0a;
  /* Lock height at paint time — prevent reflow when browser chrome animates */
  contain: layout style;
}

.website-hero__product-title,
.website-hero__product-title * {
  pointer-events: none;
}

.website-hero__product-title {
  text-align: center;
}

.website-hero__product-title--desktop {
  display: none;
}

.website-hero__product-title-inner {
  display: flex;
  align-items: center;
  justify-content: center;
}

.website-hero__product-title-part {
  margin: 0;
  font-family: var(--fc-font, sans-serif);
  font-weight: 700;
  letter-spacing: -0.05em;
  line-height: 1;
  color: #fff;
  text-shadow: 0 1px 12px rgba(0, 0, 0, 0.55);
  white-space: nowrap;
}

.website-hero__product-stack {
  position: absolute;
  z-index: 4;
  left: 50%;
  bottom: calc(clamp(10vh, 12vh, 16vh) - 28px);
  transform: translateX(-50%);
  width: auto;
  max-width: calc(100% - clamp(24px, 6vw, 48px));
  pointer-events: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: clamp(10px, 2vw, 14px);
}

.website-hero__product-cta {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  width: fit-content;
  max-width: 100%;
  margin: 0 auto;
  gap: 10px;
  pointer-events: auto;
}

.website-hero__available-copy,
#MainContent .website-hero .website-hero__available-copy {
  margin: 0;
  padding: 0;
  text-align: center;
  font-family: var(--fc-font, sans-serif);
  font-size: clamp(14px, 2.4vw, 24px);
  font-weight: 700;
  letter-spacing: -0.06em;
  line-height: 1.2;
  color: #fff;
  white-space: nowrap;
}

.website-hero__discover-more {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  align-self: stretch;
  width: 100%;
  min-height: 48px;
  padding: 14px 20px;
  border: 0;
  border-radius: 5px;
  background: var(--fc-yellow, #ffd300);
  color: #000;
  font-family: var(--fc-font, sans-serif);
  font-size: clamp(15px, 1.8vw, 18px);
  font-weight: 700;
  letter-spacing: -0.06em;
  line-height: 1.2;
  text-decoration: none;
  cursor: pointer;
  pointer-events: auto;
  transition: background-color 0.18s ease, transform 0.18s ease;
}

.website-hero__discover-more:hover {
  background: #ffe033;
  color: #000;
}

.website-hero__discover-more:active {
  transform: scale(0.98);
}

.website-hero__discover-more:focus-visible {
  outline: 2px solid #fff;
  outline-offset: 3px;
}

@media screen and (max-width: 749px) {
  .website-hero__product-stack {
    bottom: calc(clamp(40px, 9vh, 72px) - 28px);
  }

  .website-hero__product-title-inner {
    flex-wrap: wrap;
    gap: 0.28em;
  }

  .website-hero__product-title-part {
    font-size: clamp(30px, 8.2vw, 40px);
  }

  .website-hero__available-copy {
    font-size: clamp(14px, 4vw, 22px);
    white-space: normal;
  }

  .website-hero__discover-more {
    min-height: 44px;
    padding: 12px 18px;
  }
}

@media screen and (min-width: 750px) and (max-width: 989px) {
  .website-hero__product-stack {
    bottom: calc(clamp(8vh, 10vh, 12vh) - 28px);
  }
}

@media screen and (min-width: 750px) {
  .website-hero__product-title--mobile {
    display: none;
  }

  .website-hero__product-title--desktop {
    display: flex;
    position: absolute;
    inset: 0;
    z-index: 3;
    align-items: center;
    justify-content: center;
  }

  .website-hero__product-title--desktop .website-hero__product-title-inner {
    width: 100vw;
    max-width: 100vw;
    margin-inline: calc(50% - 50vw);
    gap: clamp(32px, 50vw, 70vw);
    padding-inline: clamp(20px, 5vw, 64px);
    box-sizing: border-box;
  }

  .website-hero__product-title--desktop .website-hero__product-title-part {
    font-size: clamp(32px, 5vw, 56px);
  }

  .website-hero__available-copy {
    font-size: clamp(16px, 2vw, 24px);
  }

  .website-hero__discover-more {
    min-height: 52px;
    padding: 15px 22px;
    font-size: 18px;
  }
}

@media screen and (min-width: 750px) {
  .website-hero {
    min-height: 100svh;
    min-height: 100dvh;
    contain: layout style;
  }
}

.website-hero__picture {
  position: absolute;
  inset: 0;
  overflow: hidden;
}

.website-hero__picture .website-hero__img {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  max-width: none;
  object-fit: cover;
  object-position: center center;
}

.website-hero__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0.15) 0%,
    rgba(0, 0, 0, 0.35) 55%,
    rgba(0, 0, 0, 0.75) 100%
  );
  pointer-events: none;
}

.website-hero__content {
  position: absolute;
  z-index: 1;
  inset: auto 0 0 0;
  padding: clamp(24px, 4vw, 48px) clamp(24px, 5vw, 64px);
  border-bottom: none;
  isolation: isolate;
}

/* Localized scrim behind text only — not a full-hero overlay (avoids hard edge above footer) */
.website-hero__content::before {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 160%;
  background: linear-gradient(
    to top,
    rgba(0, 0, 0, 0.5) 0%,
    rgba(0, 0, 0, 0.18) 50%,
    transparent 100%
  );
  z-index: -1;
  pointer-events: none;
}

.website-hero__heading {
  font-family: var(--fc-font, inherit);
  font-size: clamp(28px, 4.5vw, 64px);
  font-weight: 700;
  color: #fff;
  text-shadow: 0 1px 12px rgba(0, 0, 0, 0.55);
  letter-spacing: -0.05em;
  line-height: 0.95;
  margin: 0 0 12px;
  max-width: min(900px, 85%);
}

.website-hero__heading-accent {
  color: #fff;
  letter-spacing: inherit;
}

.website-hero__subheading {
  font-family: var(--fc-font, inherit);
  font-size: clamp(16px, 2vw, 24px);
  font-weight: 700;
  color: #fff;
  text-shadow: 0 1px 12px rgba(0, 0, 0, 0.55);
  letter-spacing: -0.01em;
  line-height: 1.3;
  margin: 0 0 20px;
  max-width: min(640px, 85%);
}

@media screen and (min-width: 750px) {
  .website-hero__subheading {
    letter-spacing: -0.025em;
  }
}

.website-hero__cta {
  display: inline-block;
  font-family: var(--fc-font, inherit);
  font-size: clamp(14px, 1.5vw, 18px);
  font-weight: 700;
  letter-spacing: -0.01em;
  color: #121212;
  background: var(--fc-yellow, #ffd300);
  padding: 12px 28px;
  text-decoration: none;
  transition: opacity 0.2s ease;
}

.website-hero__cta:hover {
  opacity: 0.9;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Website Hero",
  "tag": "section",
  "class": "section-website-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image (desktop)",
      "info": "Leave empty to use WebsiteHeroNomad.webp from theme assets."
    },
    {
      "type": "image_picker",
      "id": "hero_image_mobile",
      "label": "Hero image (mobile)",
      "info": "Leave empty to use WebsiteHeroNomad-Mobile.webp from theme assets."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "Finecoustic"
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show bottom gradient overlay",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Heading highlight word",
      "info": "This word is shown in brand yellow (#ffd300). Leave empty for a single-color heading.",
      "default": "Nomad"
    },
    {
      "type": "text",
      "id": "hero_subheading",
      "label": "Subheading",
      "default": "Available soon."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Featured product"
    },
    {
      "type": "checkbox",
      "id": "show_product_cta",
      "label": "Show featured product title and button",
      "default": false
    },
    {
      "type": "product",
      "id": "featured_product",
      "label": "Featured product"
    },
    {
      "type": "text",
      "id": "product_title",
      "label": "Display title",
      "default": "Hako Nomad",
      "info": "Defaults to the selected product title."
    },
    {
      "type": "text",
      "id": "availability_text",
      "label": "Availability line",
      "default": "Ready to fit in your space."
    },
    {
      "type": "text",
      "id": "discover_more_label",
      "label": "Discover More button label",
      "default": "Discover More"
    },
    {
      "type": "url",
      "id": "discover_more_url",
      "label": "Discover More link",
      "info": "Defaults to the selected product."
    }
  ],
  "presets": [
    {
      "name": "Website Hero"
    }
  ]
}
{% endschema %}
