{% doc %}
  Homepage hero preorder email gate (client-side — no Shopify customer form captcha).

  @param {object} section - Parent section object (website-hero)
{% enddoc %}

{%- liquid
  assign form_uid = form_id_suffix | default: section.id

  if preorder_offers_url != blank
    assign offers_path = preorder_offers_url
  elsif section.settings.preorder_offers_url != blank
    assign offers_path = section.settings.preorder_offers_url
  else
    assign offers_path = '/pages/preorder-offers'
  endif

  assign submit_label = preorder_button_label
  if submit_label == blank
    assign submit_label = section.settings.preorder_button_label
  endif
  if submit_label == blank
    assign submit_label = 'Reveal Preorder Offers'
  endif

  assign marketing_label = preorder_marketing_label
  if marketing_label == blank
    assign marketing_label = section.settings.preorder_marketing_label
  endif
  if marketing_label == blank
    assign marketing_label = "Be the first to experience what's next in sound."
  endif

  assign show_email_field = true
  assign show_marketing_checkbox = true
  assign customer_email = ''
  assign customer_accepts_marketing = false

  if customer
    assign show_email_field = false
    assign customer_email = customer.email
    if customer.accepts_marketing
      assign show_marketing_checkbox = false
      assign customer_accepts_marketing = true
    endif
  endif
-%}

<div class="fc-preorder-hero-form{% unless show_email_field %} fc-preorder-hero-form--logged-in{% endunless %}{% unless show_marketing_checkbox %} fc-preorder-hero-form--marketing-set{% endunless %}">
  <form
    id="fc-preorder-hero-customer-form"
    class="fc-preorder-hero-form__inner"
    action="{{ offers_path }}"
    method="get"
    novalidate
    {% if customer_email != blank %}data-customer-email="{{ customer_email | escape }}"{% endif %}
    {% if customer_accepts_marketing %}data-customer-marketing="true"{% endif %}
  >
    {%- if show_email_field -%}
      <div class="fc-preorder-hero-form__field">
        <label class="visually-hidden" for="fc-preorder-email-{{ form_uid }}">Email</label>
        <input
          id="fc-preorder-email-{{ form_uid }}"
          class="fc-preorder-hero-form__email"
          type="email"
          name="email"
          placeholder="your@email.com"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          required
        >
      </div>
    {%- endif -%}

    {%- if show_marketing_checkbox -%}
      {%- liquid
        assign marketing_toggle_id = 'fc-preorder-marketing-' | append: form_uid
      -%}
      {%- render 'fc-marketing-checkbox',
        id: marketing_toggle_id,
        name: 'accepts_marketing',
        label: marketing_label
      -%}
    {%- endif -%}

    <button type="submit" class="fc-preorder-hero-form__submit">
      {{ submit_label | escape }}
    </button>

    <p class="fc-preorder-hero-form__error" id="fc-preorder-hero-error-{{ form_uid }}" role="alert" hidden></p>
  </form>
</div>

<script>
  (function () {
    var form = document.getElementById('fc-preorder-hero-customer-form');
    if (!form) return;

    var emailInput = form.querySelector('[name="email"]');
    var marketingInput = form.querySelector('[name="accepts_marketing"]');
    var customerEmail = (form.dataset.customerEmail || '').trim();
    var customerMarketing = form.dataset.customerMarketing === 'true';
    var errorEl = document.getElementById('fc-preorder-hero-error-{{ form_uid }}');
    var offersPath = {{ offers_path | json }};

    function resolveEmail() {
      if (emailInput) return emailInput.value.trim();
      return customerEmail;
    }

    function resolveMarketing() {
      if (customerMarketing) return true;
      return !!(marketingInput && marketingInput.checked);
    }

    function isValidEmail(email) {
      if (!email) return false;
      if (emailInput) return emailInput.checkValidity();
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    }

    form.addEventListener('submit', function (event) {
      event.preventDefault();

      var nextEmail = resolveEmail();
      if (!isValidEmail(nextEmail)) {
        if (errorEl) {
          errorEl.textContent = 'Please enter a valid email address.';
          errorEl.hidden = false;
        }
        if (emailInput) emailInput.focus();
        return;
      }

      if (errorEl) errorEl.hidden = true;

      var normalizedNext = nextEmail.toLowerCase();
      try {
        var prevEmail = (sessionStorage.getItem('fc_preorder_email') || '').trim().toLowerCase();
        if (prevEmail && normalizedNext && prevEmail !== normalizedNext) {
          sessionStorage.removeItem('fc_preorder_pending_checkout');
          sessionStorage.removeItem('fc_preorder_reserve_email');
          var questionnaireRaw = sessionStorage.getItem('fc_preorder_questionnaire');
          if (questionnaireRaw) {
            var questionnaireData = JSON.parse(questionnaireRaw);
            if (questionnaireData && questionnaireData.intent === 'reserve') {
              sessionStorage.removeItem('fc_preorder_questionnaire');
            }
          }
          window.dispatchEvent(new CustomEvent('fc-preorder-email-changed', {
            detail: { email: nextEmail, previous: prevEmail }
          }));
        }
        sessionStorage.setItem('fc_preorder_email', nextEmail);
        sessionStorage.setItem('fc_preorder_marketing', resolveMarketing() ? '1' : '0');
      } catch (e) { /* ignore */ }

      window.location.href = offersPath;
    });
  })();
</script>
