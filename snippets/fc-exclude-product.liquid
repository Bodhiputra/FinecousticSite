{%- comment -%}
  Sets fc_exclude_product (use {% include %} — render isolates scope).
  Usage:
    {% include 'fc-exclude-product', product: product %}
    {% if fc_exclude_product %} … skip … {% endif %}
  Pre-release (FBS/Hako): was hidden on live until Nomad launch — now visible on all themes.
  Nomad preorder digital SKU stays hidden from grid/search.
{%- endcomment -%}
{%- liquid
  assign fc_exclude_product = false
  if product != blank
    assign fc_handle = product.handle | downcase
  elsif handle != blank
    assign fc_handle = handle | downcase
  else
    assign fc_handle = ''
  endif

  if fc_handle contains 'sonara-ufm1-test'
    assign fc_exclude_product = true
  endif

  comment
    Nomad preorder (digital) — never list on shop grid / search; PDP stays direct-link only.
  endcomment
  if fc_handle contains 'nomad-preorder' or fc_handle contains 'hako-nomad-preorder'
    assign fc_exclude_product = true
  endif
-%}
