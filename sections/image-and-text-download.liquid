<div class="fc-dl-page{% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}">

  {%- if section.settings.heading != blank -%}
    <h1 class="fc-dl-page__heading">{{ section.settings.heading | escape }}</h1>
  {%- endif -%}

  <div class="fc-dl-body" id="fc-dl-body">
    <div class="fc-grid fc-dl-grid" id="fc-dl-grid" data-cols="5">
      {%- assign dl_card_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'Text' and block.settings.download_url != blank -%}
          {%- assign dl_product = all_products[block.settings.product_handle] -%}
          {%- assign dl_name = block.settings.title -%}
          {%- if dl_name == blank and dl_product != blank -%}
            {%- assign dl_name = dl_product.title -%}
          {%- endif -%}
          <a
            class="fc-card fc-dl-card fc-card-appear"
            href="{{ block.settings.download_url }}"
            target="_blank"
            rel="noopener"
            style="animation-delay: {{ dl_card_index | times: 90 }}ms"
            aria-label="Quick Start Guide — {{ dl_name | escape }}"
            {{ block.shopify_attributes }}
          >
            <div class="fc-card__image">
              {%- if block.settings.product_handle != blank and dl_product != blank and dl_product.featured_image -%}
                {{ dl_product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'fc-card__img fc-img-active', alt: dl_name }}
              {%- elsif block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'fc-card__img fc-img-active', alt: dl_name | escape }}
              {%- endif -%}
            </div>

            {%- if dl_name != blank -%}
              <p class="fc-dl-card-name">{{ dl_name | escape }}</p>
            {%- endif -%}
          </a>
          {%- assign dl_card_index = dl_card_index | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

</div>

<script>
(function () {

  function updateGridColumns() {
    const grid = document.getElementById('fc-dl-grid');
    if (!grid) return;
    const cards = grid.querySelectorAll('.fc-dl-card:not(.fc-hidden)');
    const maxCols = parseInt(grid.dataset.cols, 10) || 5;
    const cols = Math.max(1, Math.min(cards.length, maxCols));
    grid.style.setProperty('--fc-product-cols', String(cols));
  }

  function fcFitNames() {
    document.querySelectorAll('#fc-dl-grid .fc-dl-card-name').forEach(function (el) {
      el.style.fontSize = '';
      var size = parseFloat(getComputedStyle(el).fontSize);
      while (el.scrollWidth > el.offsetWidth && size > 7) {
        size -= 0.5;
        el.style.fontSize = size + 'px';
      }
    });
  }

  function init() {
    if (!document.getElementById('fc-dl-grid')) return;
    updateGridColumns();
    fcFitNames();
  }

  init();
  document.addEventListener('shopify:section:load', function (evt) {
    if (!evt.target.querySelector || !evt.target.querySelector('#fc-dl-grid')) return;
    init();
  });

  var fcFitTimer;
  window.addEventListener('resize', function () {
    clearTimeout(fcFitTimer);
    fcFitTimer = setTimeout(function () {
      updateGridColumns();
      fcFitNames();
    }, 120);
  });

})();
</script>

{% schema %}
{
  "name": "Product Guide",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Page heading",
      "default": "Product Guide"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom class"
    }
  ],
  "blocks": [
    {
      "type": "Text",
      "name": "Product guide",
      "settings": [
        { "type": "text", "id": "product_handle", "label": "Product handle (e.g. groove-anc-ft20)" },
        { "type": "text", "id": "title", "label": "Product display name" },
        { "type": "text", "id": "download_url", "label": "Quick Start Guide PDF URL" },
        { "type": "image_picker", "id": "image", "label": "Fallback image (if product handle is blank)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Guide"
    }
  ]
}
{% endschema %}
