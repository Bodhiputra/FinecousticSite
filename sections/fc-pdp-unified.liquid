{%- liquid
  include 'fc-launch-gates'

  assign variant = product.selected_or_first_available_variant
  assign media_count = product.media.size
  assign is_available = variant.available

  assign pdp_description = product.description

  assign has_color = false
  assign color_option_pos = 0
  for option in product.options
    assign option_down = option | downcase
    if option_down == 'color' or option_down == 'colour'
      assign has_color = true
      assign color_option_pos = forloop.index0
    endif
  endfor

  assign fc_variant_gallery = false
  if section.settings.variant_image_gallery
    assign fc_variant_gallery = true
  endif
  if fc_variant_gallery == false and has_color
    assign fc_variant_image_count = 0
    for v in product.variants
      if v.featured_media or v.image
        assign fc_variant_image_count = fc_variant_image_count | plus: 1
      endif
    endfor
    if fc_variant_image_count > 1
      assign fc_variant_gallery = true
    elsif fc_variant_image_count > 0 and media_count <= 1
      assign fc_variant_gallery = true
    endif
  endif

  assign hero_image = product.featured_image
  if variant.featured_media
    assign hero_image = variant.featured_media.preview_image
  elsif variant.image
    assign hero_image = variant.image
  endif

  assign fc_desktop_stack = section.settings.desktop_stacked_layout

  capture fc_variant_sold_out_str
    render 'fc-variant-sold-out', variant: variant
  endcapture
  assign fc_variant_sold_out = fc_variant_sold_out_str | strip
  assign fc_atc_label = 'Add to bag'
  if fc_variant_sold_out == 'true'
    assign fc_atc_label = 'Sold Out'
  endif

  assign fc_preorder_gate = false
  if fc_launch_phase == 'preorder'
    assign fc_preorder_gate = section.settings.enable_preorder_gate
    if fc_preorder_gate == false
      assign fc_handle_down = product.handle | downcase
      if fc_handle_down == 'hako-nomad-fbs1' or fc_handle_down == 'hako-nomad-l-fbs2'
        assign fc_preorder_gate = true
      endif
    endif
  endif

  assign fc_show_drop_countdown = false
  assign fc_handle_down = product.handle | downcase
  if fc_launch_phase == 'countdown'
    if fc_handle_down == 'hako-nomad-fbs1' or fc_handle_down == 'hako-nomad-l-fbs2'
      assign fc_show_drop_countdown = true
    endif
  endif
-%}

{%- if fc_preorder_gate -%}
  {{ 'fc-preorder.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- render 'fc-product-data', product: product -%}

<section
  class="fc-pdp-u fc-pdp-hero{% if fc_desktop_stack %} fc-pdp-u--desktop-stack{% endif %}"
  id="fc-pdp-u-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-product-handle="{{ product.handle }}"
  {% if fc_desktop_stack %}data-fc-desktop-stack="true"{% endif %}
>
  {%- if fc_show_drop_countdown -%}
    {%- render 'fc-countdown', variant: 'pdp', launch_ts: fc_launch_ts -%}
  {%- endif -%}
  <div class="fc-pdp-u__inner">
    <div class="fc-pdp-u__hero">
      <div class="fc-pdp-u__visual">
        <div
          class="fc-pdp-u__gallery{% if fc_variant_gallery %} fc-pdp-u__gallery--variant{% endif %}{% if fc_desktop_stack %} fc-pdp-u__gallery--desktop-vertical{% endif %}"
          data-fc-pdp-gallery
          {% if fc_variant_gallery %}data-fc-variant-gallery{% endif %}
        >
          <div class="fc-pdp-u__slides">
            {%- if fc_variant_gallery -%}
              <div class="fc-pdp-u__slide is-active" data-fc-variant-slide>
                {%- if hero_image -%}
                  {{ hero_image | image_url: width: 1200 | image_tag:
                    class: 'fc-pdp-u__slide-media',
                    loading: 'eager',
                    sizes: '(min-width: 990px) 640px, 92vw',
                    widths: '600, 800, 1000, 1200',
                    alt: variant.title | default: product.title | escape
                  }}
                {%- endif -%}
              </div>
            {%- elsif media_count > 0 -%}
              {%- for media in product.media -%}
                {%- liquid
                  if forloop.first
                    assign fc_slide_preload = 'metadata'
                    assign fc_slide_loading = 'eager'
                    assign fc_slide_fetchpriority = 'high'
                  else
                    assign fc_slide_preload = 'none'
                    assign fc_slide_loading = 'lazy'
                    assign fc_slide_fetchpriority = 'low'
                  endif
                -%}
                <div class="fc-pdp-u__slide{% if forloop.first %} is-active{% endif %}" data-slide-index="{{ forloop.index0 }}">
                  {%- if media.media_type == 'video' -%}
                    {{ media | video_tag:
                      class: 'fc-pdp-u__slide-media',
                      autoplay: false,
                      loop: true,
                      muted: true,
                      playsinline: true,
                      controls: false,
                      preload: fc_slide_preload
                    }}
                  {%- else -%}
                    {{ media | image_url: width: 1200 | image_tag:
                      class: 'fc-pdp-u__slide-media',
                      loading: fc_slide_loading,
                      fetchpriority: fc_slide_fetchpriority,
                      sizes: '(min-width: 990px) 640px, 92vw',
                      widths: '600, 800, 1000, 1200',
                      alt: media.alt | default: product.title | escape
                    }}
                  {%- endif -%}
                </div>
              {%- endfor -%}
            {%- elsif product.featured_image -%}
              <div class="fc-pdp-u__slide is-active" data-slide-index="0">
                {{ product.featured_image | image_url: width: 1200 | image_tag:
                  class: 'fc-pdp-u__slide-media',
                  loading: 'eager',
                  alt: product.title | escape
                }}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>

      <div class="fc-pdp-u__meta">
        <div class="fc-pdp-u__meta-center">
        <div class="fc-pdp-u__lead">
        <h1 class="fc-pdp-u__title">{{ product.title | escape }}</h1>

        {%- if pdp_description != blank -%}
          <div class="fc-pdp-u__description rte">{{ pdp_description }}</div>
        {%- endif -%}
        </div>

        {%- unless product.has_only_default_variant -%}
          <div class="fc-pdp-u__variants" data-fc-pdp-variants>
            <span class="fc-pdp-u__variants-label">{{ product.options[0] | default: 'Option' | downcase | capitalize }}</span>
            <div class="fc-pdp-u__variant-list">
              {%- for v in product.variants -%}
                {%- liquid
                  assign v_hero = null
                  if v.featured_media
                    assign v_hero = v.featured_media.preview_image
                  elsif v.image
                    assign v_hero = v.image
                  endif
                -%}
                <button
                  type="button"
                  class="fc-pdp-u__variant{% if v.id == variant.id %} is-selected{% endif %}{% unless v.available %} is-unavailable{% endunless %}"
                  data-variant-id="{{ v.id }}"
                  data-variant-price="{{ v.price | money | escape }}"
                  data-variant-available="{% if v.available %}true{% else %}false{% endif %}"
                  {% if v_hero %}data-variant-image="{{ v_hero | image_url: width: 1200 }}"{% endif %}
                  aria-pressed="{% if v.id == variant.id %}true{% else %}false{% endif %}"
                >
                  {{ v.title | downcase | capitalize }}
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endunless -%}

        {%- if section.settings.sibling_1_label != blank or section.settings.sibling_2_label != blank -%}
          <div class="fc-pdp-u__siblings">
            <span class="fc-pdp-u__variants-label">Size</span>
            <div class="fc-pdp-u__variant-list">
              {%- if section.settings.sibling_1_label != blank -%}
                <a
                  href="{{ section.settings.sibling_1_url }}"
                  class="fc-pdp-u__variant fc-pdp-u__sibling{% if section.settings.sibling_1_url contains product.handle %} is-selected{% endif %}"
                >{{ section.settings.sibling_1_label }}</a>
              {%- endif -%}
              {%- if section.settings.sibling_2_label != blank -%}
                <a
                  href="{{ section.settings.sibling_2_url }}"
                  class="fc-pdp-u__variant fc-pdp-u__sibling{% if section.settings.sibling_2_url contains product.handle %} is-selected{% endif %}"
                >{{ section.settings.sibling_2_label }}</a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

        <div class="fc-pdp-u__buy" data-fc-pdp-purchase>
          {%- if fc_preorder_gate -%}
            <div class="fc-pdp-u__preorder">
              {%- render 'fc-preorder-hero-form',
                section: section,
                preorder_button_label: section.settings.preorder_button_label,
                preorder_marketing_label: section.settings.preorder_marketing_label,
                preorder_offers_url: section.settings.preorder_offers_url,
                form_id_suffix: section.id
              -%}
            </div>
          {%- elsif fc_show_drop_countdown -%}
          <button
            type="button"
            class="fc-pdp-u__atc is-launch-locked"
            data-variant-id="{{ variant.id }}"
            data-fc-purchasable="false"
            data-fc-launch-locked="true"
            data-fc-atc-label-default="{{ fc_atc_label | escape }}"
            disabled
            aria-disabled="true"
          >
            <span class="fc-pdp-u__atc-price" data-fc-pdp-price>
              {%- if product.price_varies -%}<span class="fc-pdp-u__price-from">From</span> {%- endif -%}
              {{ variant.price | money }}
            </span>
            <span class="fc-pdp-u__atc-sep fc-pdp-u__atc-sep--qty" data-fc-pdp-atc-qty-sep hidden aria-hidden="true">·</span>
            <span class="fc-pdp-u__atc-qty" data-fc-pdp-atc-qty hidden></span>
            <span class="fc-pdp-u__atc-sep" aria-hidden="true">·</span>
            <span class="fc-pdp-u__atc-label" data-fc-pdp-atc-label>{{ fc_atc_label }}</span>
          </button>
          {%- else -%}
          <button
            type="button"
            class="fc-pdp-u__atc{% if fc_variant_sold_out == 'true' %} is-oos{% endif %}"
            data-variant-id="{{ variant.id }}"
            data-fc-purchasable="{% if fc_variant_sold_out == 'true' %}false{% else %}true{% endif %}"
            data-fc-atc-label-default="{{ fc_atc_label | escape }}"
            {% if fc_variant_sold_out == 'true' %}aria-disabled="true"{% endif %}
          >
            <span class="fc-pdp-u__atc-price" data-fc-pdp-price>
              {%- if product.price_varies -%}<span class="fc-pdp-u__price-from">From</span> {%- endif -%}
              {{ variant.price | money }}
            </span>
            <span class="fc-pdp-u__atc-sep fc-pdp-u__atc-sep--qty" data-fc-pdp-atc-qty-sep hidden aria-hidden="true">·</span>
            <span class="fc-pdp-u__atc-qty" data-fc-pdp-atc-qty hidden></span>
            <span class="fc-pdp-u__atc-sep" aria-hidden="true">·</span>
            <span class="fc-pdp-u__atc-label" data-fc-pdp-atc-label>{{ fc_atc_label }}</span>
          </button>
          {%- endif -%}
        </div>

        {%- if fc_desktop_stack -%}
          <div class="fc-pdp-u__meta-accordions fc-pdp-u__specs fc-pdp-u__specs--desktop">
            <div class="fc-pdp-specs-inbox__inner">
              {%- render 'fc-pdp-specs-inbox-inner', section: section -%}
            </div>
          </div>
        {%- endif -%}
        </div>
      </div>
    </div>

    <div class="fc-pdp-u__specs fc-pdp-u__specs--mobile">
      <div class="fc-pdp-specs-inbox__inner">
        {%- render 'fc-pdp-specs-inbox-inner', section: section -%}
      </div>
    </div>

  </div>

    {%- liquid
      assign fc_video = section.settings.video
      assign fc_video_mp4 = section.settings.video_mp4_url
      assign fc_video_url = section.settings.video_url
      assign fc_video_loop = section.settings.enable_video_looping
      assign fc_video_poster = section.settings.video.preview_image | default: section.settings.cover_image
      assign fc_video_heading = section.settings.video_heading
      assign fc_video_desc = section.settings.video_description
      assign fc_video_id = section.settings.video_url.id
    -%}
    {%- if fc_video != null or fc_video_mp4 != blank or fc_video_url != null or section.settings.cover_image != null -%}
    <div class="fc-pdp-u__video-wrap" data-fc-pdp-video-wrap>
      {%- unless fc_video_heading == blank -%}
        <h2 class="fc-pdp-u__video-heading">{{ fc_video_heading | escape }}</h2>
      {%- endunless -%}
      <div
        class="fc-pdp-u__video-media fc-video-always-on"
        data-fc-loop="{% if fc_video_loop %}true{% else %}false{% endif %}"
      >
        {%- if fc_video != null -%}
          {{
            fc_video
            | video_tag:
              class: 'fc-video-always-on__video fc-pdp-u__video-video',
              image_size: '1400x',
              autoplay: true,
              loop: false,
              controls: false,
              muted: true,
              playsinline: true,
              preload: 'metadata',
              poster: fc_video_poster
          }}
        {%- elsif fc_video_mp4 != blank -%}
          <video
            class="fc-video-always-on__video fc-pdp-u__video-video"
            autoplay
            muted
            playsinline
            preload="metadata"
          >
            <source src="{{ fc_video_mp4 | escape }}" type="video/mp4">
          </video>
        {%- elsif fc_video_url != null -%}
          {%- liquid
            assign loop_param = ''
            if fc_video_loop
              assign loop_param = '&loop=1&playlist=' | append: fc_video_id
            endif
          -%}
          {%- if fc_video_url.type == 'youtube' -%}
            <iframe
              src="https://www.youtube.com/embed/{{ fc_video_id }}?enablejsapi=1&autoplay=1&mute=1{{ loop_param }}"
              class="js-youtube fc-video-always-on__iframe fc-pdp-u__video-iframe"
              allow="autoplay; encrypted-media"
              allowfullscreen
              title="{{ fc_video_desc | default: fc_video_heading | escape }}"
            ></iframe>
          {%- else -%}
            <iframe
              src="https://player.vimeo.com/video/{{ fc_video_id }}?autoplay=1&muted=1{% if fc_video_loop %}&loop=1{% endif %}"
              class="js-vimeo fc-video-always-on__iframe fc-pdp-u__video-iframe"
              allow="autoplay; encrypted-media"
              allowfullscreen
              title="{{ fc_video_desc | default: fc_video_heading | escape }}"
            ></iframe>
          {%- endif -%}
        {%- elsif section.settings.cover_image != null -%}
          {{
            section.settings.cover_image
            | image_url: width: 2000
            | image_tag:
              class: 'fc-pdp-u__video-poster',
              loading: 'lazy',
              sizes: '100vw',
              widths: '750, 1100, 1500, 2000',
              alt: fc_video_desc | default: fc_video_heading | escape
          }}
        {%- endif -%}
      </div>
    </div>
    {%- endif -%}
</section>

{%- unless fc_preorder_gate -%}
<div class="fc-pdp-u__dock" id="fc-pdp-u-dock-{{ section.id }}" hidden>
  <button
    type="button"
    class="fc-pdp-u__atc fc-pdp-u__atc--dock{% if fc_variant_sold_out == 'true' %} is-oos{% endif %}{% if fc_show_drop_countdown %} is-launch-locked{% endif %}"
    data-variant-id="{{ variant.id }}"
    data-fc-purchasable="{% if fc_show_drop_countdown or fc_variant_sold_out == 'true' %}false{% else %}true{% endif %}"
    data-fc-atc-label-default="{{ fc_atc_label | escape }}"
    {% if fc_show_drop_countdown %}data-fc-launch-locked="true" disabled aria-disabled="true"{% elsif fc_variant_sold_out == 'true' %}aria-disabled="true"{% endif %}
  >
    <span class="fc-pdp-u__atc-price" data-fc-pdp-price>
      {%- if product.price_varies -%}<span class="fc-pdp-u__price-from">From</span> {%- endif -%}
      {{ variant.price | money }}
    </span>
    <span class="fc-pdp-u__atc-sep fc-pdp-u__atc-sep--qty" data-fc-pdp-atc-qty-sep hidden aria-hidden="true">·</span>
    <span class="fc-pdp-u__atc-qty" data-fc-pdp-atc-qty hidden></span>
    <span class="fc-pdp-u__atc-sep" aria-hidden="true">·</span>
    <span class="fc-pdp-u__atc-label" data-fc-pdp-atc-label>{{ fc_atc_label }}</span>
  </button>
</div>
{%- endunless -%}

{% stylesheet %}
.fc-pdp-u {
  padding: 0;
  padding-bottom: 48px;
}

.fc-pdp-u.fc-pdp-hero {
  box-sizing: border-box;
  padding-top: 0;
}

.fc-pdp-u__inner {
  width: min(1280px, 96vw);
  max-width: none;
  margin: 0 auto;
  padding: 0 clamp(20px, 4vw, 48px);
  box-sizing: border-box;
}

.fc-pdp-u__hero {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  align-items: stretch;
  min-height: min(88vh, 900px);
}

@media screen and (max-width: 989px) {
  .fc-pdp-u__hero {
    grid-template-columns: 1fr;
    min-height: 0;
    gap: 0;
  }
  .fc-pdp-u__meta {
    padding-top: 24px;
  }
}

.fc-pdp-u__visual {
  width: 100%;
  min-width: 0;
}

.fc-pdp-u__gallery {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: min(78vh, 800px);
}

.fc-pdp-u__slides {
  position: relative;
  flex: 1 1 auto;
  width: 100%;
  height: min(640px, 74vh);
  min-height: 0;
  overflow: hidden;
}

.fc-pdp-u__slides .fc-ig-track {
  min-height: inherit;
}

.fc-pdp-u__slide {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: min(640px, 74vh);
  min-height: 0;
  max-height: min(640px, 74vh);
  overflow: hidden;
  flex-shrink: 0;
}

.fc-pdp-u__slide.is-active {
  opacity: 1;
  padding-top: 0;
  padding-bottom: 0;
}

.fc-pdp-u__slide-media {
  display: block;
  width: min(640px, 100%);
  height: min(640px, 74vh);
  object-fit: contain;
  margin: 0 auto;
}


@media screen and (max-width: 989px) {
  .fc-pdp-u__visual {
    min-height: 0;
  }
  .fc-pdp-u__gallery {
    min-height: 0;
  }
  .fc-pdp-u__slides {
    min-height: 0;
  }
  .fc-pdp-u__slide {
    min-height: 0;
    max-height: clamp(240px, 60vw, 420px);
  }
  .fc-pdp-u__slide-media {
    width: 100%;
    height: clamp(240px, 60vw, 420px);
    object-fit: contain;
    margin: 0 auto;
  }
}

.fc-pdp-u__gallery--variant .fc-pdp-u__slides {
  overflow: visible;
}

.fc-pdp-u__gallery--variant .fc-ig-dots,
.fc-pdp-u__gallery--variant.fc-ig-viewport > .fc-ig-dots {
  display: none !important;
}

@media screen and (max-width: 989px) {
  .fc-pdp-u__gallery--variant .fc-ig-dots,
  .fc-pdp-u__gallery--variant.fc-ig-viewport > .fc-ig-dots {
    display: flex !important;
  }
}

.fc-pdp-u__meta {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  width: 100%;
  min-width: 0;
  padding: clamp(32px, 5vh, 64px) clamp(24px, 4vw, 48px);
}

.fc-pdp-u__meta-center {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  text-align: left;
  width: 100%;
}

@media screen and (min-width: 990px) {
  .fc-pdp-u__meta-center {
    align-items: center;
    text-align: center;
  }

  .fc-pdp-u__lead {
    align-self: center;
  }
}

.fc-pdp-u__lead {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  width: 100%;
  max-width: min(560px, 100%);
}

.fc-pdp-u__title {
  font-family: var(--fc-font);
  font-size: clamp(28px, 4.5vw, 52px);
  font-weight: 700;
  line-height: 0.95;
  letter-spacing: -0.02em;
  color: #ffffff;
  margin: 0 0 12px;
  width: 100%;
  text-align: left;
}

.fc-pdp-u__price-from {
  margin-right: 4px;
}

.fc-pdp-u__description {
  font-family: var(--fc-font);
  font-size: clamp(15px, 1.65vw, 18px);
  font-weight: 500;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.72);
  margin: 0 0 20px;
  width: 100%;
  text-align: justify;
}

.fc-pdp-u__description ul {
  list-style: disc;
  margin: 0.75em 0 0;
  padding-left: 1.25em;
  text-align: left;
}

.fc-pdp-u__description li {
  margin-bottom: 0.35em;
}

.fc-pdp-u__description li:last-child {
  margin-bottom: 0;
}

.fc-pdp-u__description strong,
.fc-pdp-u__description b {
  color: rgba(255, 255, 255, 0.92);
  font-weight: 700;
}

.fc-pdp-u__siblings {
  margin-bottom: 20px;
  width: 100%;
  max-width: min(560px, 100%);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.fc-pdp-u__variants {
  margin-bottom: 20px;
  width: 100%;
  max-width: min(560px, 100%);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.fc-pdp-u__variants-label {
  display: block;
  font-family: var(--fc-font);
  font-size: 13px;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.45);
  margin-bottom: 10px;
}

.fc-pdp-u__variant-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  gap: 8px;
}

.fc-pdp-u__variant {
  font-family: var(--fc-font);
  font-size: 12px;
  font-weight: 600;
  padding: 10px 14px;
  border: 1px solid rgba(255, 255, 255, 0.2);
  background: transparent;
  color: rgba(255, 255, 255, 0.7);
  cursor: pointer;
  text-decoration: none;
}

.fc-pdp-u__variant.is-selected {
  border-color: var(--fc-yellow);
  color: #ffffff;
}

.fc-pdp-u__variant.is-unavailable {
  opacity: 0.55;
}

.fc-pdp-u__variant.is-disabled,
.fc-pdp-u__variant:disabled {
  opacity: 0.35;
  cursor: not-allowed;
}

.fc-pdp-u__buy {
  display: flex;
  justify-content: flex-start;
  width: 100%;
  max-width: min(560px, 100%);
}

.fc-pdp-u__preorder {
  width: 100%;
}

.fc-pdp-u__preorder .fc-preorder-hero-form {
  width: 100%;
}

.fc-pdp-u__preorder .fc-preorder-hero-form__submit {
  border-radius: 3px;
  font-size: clamp(14px, 1.2vw, 16px);
  min-height: 48px;
}

.fc-pdp-u__preorder .fc-marketing-checkbox__label {
  color: rgba(255, 255, 255, 0.82);
}

.fc-pdp-u__atc {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.35em;
  font-family: var(--fc-font);
  font-size: clamp(14px, 1.2vw, 16px);
  font-weight: 700;
  letter-spacing: -0.01em;
  color: #121212;
  background: var(--fc-yellow);
  border: none;
  border-radius: 3px;
  padding: 16px 32px;
  min-height: 48px;
  min-width: 200px;
  width: 100%;
  cursor: pointer;
  transition: opacity 0.15s ease;
}

@media (hover: hover) {
  .fc-pdp-u__atc:hover:not(:disabled) {
    opacity: 0.85;
  }
}

.fc-pdp-u__atc.is-oos,
.fc-pdp-u__atc:disabled {
  opacity: 0.72;
  cursor: not-allowed;
}

.fc-pdp-u__atc.is-launch-locked {
  background: rgba(255, 211, 0, 0.38);
  color: rgba(18, 18, 18, 0.52);
  opacity: 1;
  cursor: not-allowed;
}

.fc-pdp-u__atc.is-launch-locked .fc-pdp-u__atc-sep {
  opacity: 0.45;
}

@media (hover: hover) {
  .fc-pdp-u__atc.is-launch-locked:hover {
    opacity: 1;
  }
}

.fc-pdp-u__atc-sep {
  opacity: 0.55;
}

.fc-pdp-u__oos {
  font-family: var(--fc-font);
  font-size: 13px;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.45);
  margin: 0;
}

.fc-pdp-u__oos--dock {
  padding: 12px 16px;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 3px;
  text-align: center;
  width: min(100%, 320px);
}

.fc-pdp-u__dock {
  display: none;
}

.fc-pdp-u__meta-accordions {
  display: none;
  width: 100%;
  text-align: left;
}

@media screen and (min-width: 990px) {
  .fc-pdp-u--desktop-stack .fc-pdp-u__hero {
    min-height: 0;
    align-items: start;
  }

  .fc-pdp-u.fc-pdp-hero {
    padding-top: var(--fc-nav-clearance);
  }

  .fc-pdp-u.fc-pdp-hero .fc-pdp-u__inner {
    width: 100%;
    max-width: none;
    margin-left: 0;
    margin-right: 0;
    padding-left: 24px;
    padding-right: 24px;
  }

  .fc-pdp-u--desktop-stack .fc-pdp-u__hero {
    align-items: flex-start;
    min-height: 0;
  }

  .fc-pdp-u--desktop-stack .fc-pdp-u__visual {
    min-height: 0;
    align-self: start;
    position: relative;
    top: auto;
    overflow: visible;
    padding-top: clamp(56px, 12vh, 160px);
  }

  /* Balenciaga-style: images stacked vertically; page scroll reveals each slide */
  .fc-pdp-u--desktop-stack .fc-pdp-u__gallery--desktop-vertical {
    align-items: stretch;
    min-height: 0;
    height: auto;
  }

  .fc-pdp-u--desktop-stack .fc-pdp-u__gallery--desktop-vertical .fc-pdp-u__slides {
    display: flex;
    flex-direction: column;
    gap: clamp(72px, 12vh, 140px);
    overflow: visible;
    max-height: none;
    min-height: 0;
    height: auto;
    position: static;
  }

  .fc-pdp-u--desktop-stack .fc-pdp-u__gallery--desktop-vertical .fc-pdp-u__slide {
    flex: 0 0 auto;
    box-sizing: border-box;
    width: 100%;
    height: auto;
    min-height: min(360px, 50vh);
    max-height: none;
    padding: clamp(16px, 3vh, 32px) 0;
    opacity: 1;
    scroll-snap-align: start;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fc-pdp-u--desktop-stack .fc-pdp-u__gallery--desktop-vertical .fc-pdp-u__slide-media {
    display: block;
    width: min(640px, 100%);
    height: auto;
    max-width: 100%;
    max-height: min(720px, 88vh);
    object-fit: contain;
    margin: 0 auto;
    opacity: 1;
    filter: blur(0);
    transition: opacity 0.45s ease, filter 0.45s ease;
  }

  /* FBS1 hero PNG has extra padding — zoom first slide only */
  .fc-pdp-u[data-product-handle="hako-nomad-fbs1"] .fc-pdp-u__slides > .fc-pdp-u__slide:first-child {
    overflow: visible;
  }

  .fc-pdp-u[data-product-handle="hako-nomad-fbs1"] .fc-pdp-u__slides > .fc-pdp-u__slide:first-child .fc-pdp-u__slide-media {
    transform: scale(1.22);
    transform-origin: center center;
  }

  .fc-pdp-u--desktop-stack .fc-pdp-u__gallery--desktop-vertical .fc-pdp-u__slide:not(.is-active) .fc-pdp-u__slide-media {
    opacity: 0.55;
    filter: blur(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .fc-pdp-u--desktop-stack .fc-pdp-u__gallery--desktop-vertical .fc-pdp-u__slide-media {
      transition: none;
    }

    .fc-pdp-u--desktop-stack .fc-pdp-u__gallery--desktop-vertical .fc-pdp-u__slide:not(.is-active) .fc-pdp-u__slide-media {
      opacity: 0.72;
      filter: none;
    }
  }

  .fc-pdp-u--desktop-stack .fc-pdp-u__gallery .fc-ig-dots {
    display: none !important;
  }

  .fc-pdp-u--desktop-stack .fc-pdp-u__meta {
    position: sticky;
    top: var(--fc-nav-clearance);
    align-self: start;
    height: auto;
    max-height: none;
    overflow-y: visible;
    overscroll-behavior: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
  }

  .fc-pdp-u--desktop-stack .fc-pdp-u__meta-center {
    width: 100%;
    padding: clamp(20px, 3vw, 40px) 0;
    box-sizing: border-box;
  }

  .fc-pdp-u--desktop-stack .fc-pdp-u__meta-accordions {
    max-width: min(560px, 100%);
  }

  .fc-pdp-u--desktop-stack .fc-pdp-u__meta-accordions {
    display: block;
    margin-top: clamp(16px, 2vw, 24px);
    width: 100%;
  }

  .fc-pdp-u--desktop-stack .fc-pdp-u__meta-accordions .fc-pdp-specs-inbox__inner {
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 100%;
  }

  .fc-pdp-u--desktop-stack .fc-pdp-u__meta-accordions .fc-pdp-acc > .fc-pdp-acc__summary,
  .fc-pdp-u--desktop-stack .fc-pdp-u__meta-accordions .fc-pdp-acc__body,
  .fc-pdp-u--desktop-stack .fc-pdp-u__meta-accordions .fc-pdp-guide-row {
    padding-left: 0;
    padding-right: 0;
  }

  .fc-pdp-u--desktop-stack .fc-pdp-u__meta-accordions .fc-pdp-acc:first-child {
    border-top: none;
  }
}

@media screen and (max-width: 989px) {
  .fc-pdp-u.fc-pdp-hero {
    padding-bottom: clamp(12px, 2.5vw, 16px);
    padding-top: var(--fc-nav-clearance);
  }

  .fc-pdp-u.fc-pdp-hero .fc-pdp-u__inner {
    width: 100%;
    padding: 0 clamp(16px, 4vw, 24px);
  }

  .fc-pdp-u__hero {
    display: flex;
    flex-direction: column;
    gap: clamp(10px, 2.5vw, 14px);
    align-items: stretch;
    min-height: 0;
  }

  .fc-pdp-u__visual {
    flex: 0 0 auto;
    width: 100%;
    max-width: min(100%, 520px);
    min-height: 0;
    margin: 0 auto;
    padding-top: clamp(8px, 2vw, 16px);
  }

  .fc-pdp-u__preorder .fc-preorder-hero-form__email,
  .fc-pdp-u__preorder .fc-preorder-hero-form__submit {
    font-size: clamp(11px, 2.8vw, 12px);
    padding: clamp(6px, 1.6vw, 8px) clamp(8px, 2.2vw, 10px);
    min-height: 0;
    height: auto;
    border-radius: 4px;
  }

  .fc-pdp-u__preorder .fc-preorder-hero-form__inner {
    gap: clamp(6px, 1.6vw, 8px);
  }

  .fc-pdp-u__gallery {
    width: 100%;
    min-height: 0;
  }

  .fc-pdp-u__slides {
    position: relative;
    min-height: min(40vh, 400px);
    height: min(40vh, 400px);
  }

  .fc-pdp-u__slides .fc-ig-track {
    min-height: min(40vh, 400px);
    height: min(40vh, 400px);
  }

  .fc-pdp-u__slide {
    min-height: min(40vh, 400px);
    height: min(40vh, 400px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fc-pdp-u__slide-media {
    max-height: min(40vh, 400px);
    max-width: 100%;
    width: auto;
    height: auto;
    margin: 0 auto;
    object-fit: contain;
  }

  .fc-pdp-u[data-product-handle="hako-nomad-fbs1"] .fc-pdp-u__slides > .fc-pdp-u__slide:first-child {
    overflow: visible;
  }

  .fc-pdp-u[data-product-handle="hako-nomad-fbs1"] .fc-pdp-u__slides > .fc-pdp-u__slide:first-child .fc-pdp-u__slide-media {
    transform: scale(1.18);
    transform-origin: center center;
  }

  .fc-pdp-u__meta {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    max-width: none;
    width: 100%;
    margin: 0;
  }

  .fc-pdp-u__title {
    font-size: clamp(20px, 5.2vw, 26px);
    margin: 0 0 6px;
    line-height: 1.05;
  }

  .fc-pdp-u__description {
    font-size: clamp(13px, 3.4vw, 15px);
    line-height: 1.45;
    margin: 0 0 10px;
  }

  .fc-pdp-u__variants {
    margin-bottom: 8px;
  }

  .fc-pdp-u__buy {
    display: flex;
    width: 100%;
    margin-top: 0;
  }

  .fc-pdp-u__atc {
    max-width: none;
    padding: 14px 20px;
    min-height: 44px;
    font-size: clamp(13px, 3.4vw, 15px);
  }

  .fc-pdp-u__dock {
    display: none !important;
  }
}

/* ── Inline product video ── */
.fc-pdp-u__video-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: clamp(20px, 3vw, 32px);
  width: 100%;
  padding-top: clamp(32px, 5vw, 64px);
}

.fc-pdp-u__video-heading {
  font-family: var(--fc-font);
  font-size: clamp(24px, 3vw, 40px);
  font-weight: 700;
  letter-spacing: -0.03em;
  color: #ffffff;
  margin: 0;
  text-align: center;
}

.fc-pdp-u__video-media {
  width: 100%;
  max-width: min(1400px, 100%);
  max-height: 700px;
  aspect-ratio: 1400 / 700;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.04);
  position: relative;
}

/* FBS Nomad PDP — edge-to-edge product video */
.fc-pdp-u[data-product-handle="hako-nomad-fbs1"] .fc-pdp-u__video-wrap,
.fc-pdp-u[data-product-handle="hako-nomad-l-fbs2"] .fc-pdp-u__video-wrap {
  width: 100%;
  max-width: none;
  padding-left: 0;
  padding-right: 0;
}

.fc-pdp-u[data-product-handle="hako-nomad-fbs1"] .fc-pdp-u__video-media,
.fc-pdp-u[data-product-handle="hako-nomad-l-fbs2"] .fc-pdp-u__video-media {
  max-width: none;
  max-height: none;
  aspect-ratio: auto;
}

.fc-pdp-u[data-product-handle="hako-nomad-fbs1"] .fc-pdp-u__video-video,
.fc-pdp-u[data-product-handle="hako-nomad-l-fbs2"] .fc-pdp-u__video-video,
.fc-pdp-u[data-product-handle="hako-nomad-fbs1"] .fc-pdp-u__video-poster,
.fc-pdp-u[data-product-handle="hako-nomad-l-fbs2"] .fc-pdp-u__video-poster {
  width: 100%;
  height: auto;
  max-height: none;
  aspect-ratio: unset;
  object-fit: cover;
}

.fc-pdp-u[data-product-handle="hako-nomad-fbs1"] .fc-pdp-u__video-media:has(.fc-pdp-u__video-iframe),
.fc-pdp-u[data-product-handle="hako-nomad-l-fbs2"] .fc-pdp-u__video-media:has(.fc-pdp-u__video-iframe) {
  aspect-ratio: 16 / 9;
}

.fc-pdp-u__video-video,
.fc-pdp-u__video-iframe,
.fc-pdp-u__video-poster {
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  border: none;
}

.fc-pdp-u__video-iframe {
  position: absolute;
  inset: 0;
}
{% endstylesheet %}

<script src="{{ 'fc-pdp-unified.js' | asset_url }}" defer></script>
{%- if section.settings.video != blank or section.settings.video_mp4_url != blank -%}
<script src="{{ 'fc-pdp-video.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "FC PDP — Unified hero",
  "tag": "section",
  "class": "fc-pdp-unified-section",
  "settings": [
    {
      "type": "checkbox",
