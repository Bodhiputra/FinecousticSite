{%- liquid
  assign countdown_variant = variant | default: 'hero'
  assign countdown_suffix = suffix | default: 'till Nomad drop'
  assign countdown_launch_ts = launch_ts | default: fc_launch_ts
-%}

{{ 'fc-countdown.css' | asset_url | stylesheet_tag }}
<script src="{{ 'fc-countdown.js' | asset_url }}" defer="defer"></script>

<div
  class="fc-countdown fc-countdown--{{ countdown_variant }}"
  data-fc-countdown
  data-launch-ts="{{ countdown_launch_ts }}"
  role="timer"
  aria-live="polite"
>
  <span class="visually-hidden" data-fc-countdown-a11y></span>
  <div class="fc-countdown__row">
    <div class="fc-countdown__timer" data-fc-countdown-timer>
      <div class="fc-countdown__segment">
        <div class="fc-countdown__roll" data-fc-countdown-roll="days">
          <div class="fc-countdown__roll-viewport">
            <div class="fc-countdown__roll-track" data-fc-roll-track>
              <span class="fc-countdown__roll-value">0</span>
            </div>
          </div>
        </div>
        <span class="fc-countdown__label">days</span>
      </div>
      <span class="fc-countdown__sep" aria-hidden="true">:</span>
      <div class="fc-countdown__segment">
        <div class="fc-countdown__roll" data-fc-countdown-roll="hours">
          <div class="fc-countdown__roll-viewport">
            <div class="fc-countdown__roll-track" data-fc-roll-track>
              <span class="fc-countdown__roll-value">0</span>
            </div>
          </div>
        </div>
        <span class="fc-countdown__label">hours</span>
      </div>
      <span class="fc-countdown__sep" aria-hidden="true">:</span>
      <div class="fc-countdown__segment">
        <div class="fc-countdown__roll" data-fc-countdown-roll="minutes">
          <div class="fc-countdown__roll-viewport">
            <div class="fc-countdown__roll-track" data-fc-roll-track>
              <span class="fc-countdown__roll-value">0</span>
            </div>
          </div>
        </div>
        <span class="fc-countdown__label">minutes</span>
      </div>
      <span class="fc-countdown__sep" aria-hidden="true">:</span>
      <div class="fc-countdown__segment">
        <div class="fc-countdown__roll" data-fc-countdown-roll="seconds">
          <div class="fc-countdown__roll-viewport">
            <div class="fc-countdown__roll-track" data-fc-roll-track>
              <span class="fc-countdown__roll-value">0</span>
            </div>
          </div>
        </div>
        <span class="fc-countdown__label">seconds</span>
      </div>
      <div class="fc-countdown__suffix-col">
        <span class="fc-countdown__suffix" style="color:#ffd300;-webkit-text-fill-color:#ffd300">{{ countdown_suffix | escape }}</span>
        <span class="fc-countdown__suffix-spacer" aria-hidden="true">seconds</span>
      </div>
    </div>
  </div>
</div>
<script>
  (function () {
    var root = document.currentScript && document.currentScript.previousElementSibling;
    if (!root || !root.hasAttribute('data-fc-countdown')) return;
    var launchTs = parseInt(root.getAttribute('data-launch-ts'), 10);
    if (!launchTs || Math.floor(Date.now() / 1000) < launchTs) return;
    root.classList.add('is-complete');
    window.__fcLaunchCompleteHandled = true;
    var stack = root.closest('.fc-preorder-hero-stack--countdown');
    if (stack && stack.dataset.fcClientLaunched !== '1') {
      stack.dataset.fcClientLaunched = '1';
      stack.classList.remove('fc-preorder-hero-stack--countdown');
      stack.classList.add('fc-preorder-hero-stack--launched');
      root.remove();
      var cta = document.createElement('div');
      cta.className = 'fc-preorder-hero-launched-cta';
      cta.innerHTML =
        '<p class="website-hero__available-copy">Ready to fit in your space.</p>' +
        '<a class="website-hero__discover-more" href="/products/hako-nomad-fbs1">Discover More</a>';
      stack.appendChild(cta);
      document
        .querySelectorAll(
          '.fc-pdp-u__atc.is-launch-locked, .fc-pdp-u__atc[data-fc-launch-locked="true"], [data-fc-launch-locked="true"]'
        )
        .forEach(function (el) {
          el.classList.remove('is-launch-locked');
          delete el.dataset.fcLaunchLocked;
          el.disabled = false;
          el.removeAttribute('aria-disabled');
        });
      window.dispatchEvent(new CustomEvent('fc-launch-live'));
      return;
    }
    root.remove();
    document
      .querySelectorAll(
        '.fc-pdp-u__atc.is-launch-locked, .fc-pdp-u__atc[data-fc-launch-locked="true"], [data-fc-launch-locked="true"]'
      )
      .forEach(function (el) {
        el.classList.remove('is-launch-locked');
        delete el.dataset.fcLaunchLocked;
        el.disabled = false;
        el.removeAttribute('aria-disabled');
      });
    window.dispatchEvent(new CustomEvent('fc-launch-live'));
  })();
</script>
