{%- comment -%}
  Sets fc_exclude_product (use {% include %} — render isolates scope).
  Usage:
    {% include 'fc-exclude-product', product: product %}
    {% if fc_exclude_product %} … skip … {% endif %}
{%- endcomment -%}
{%- liquid
  assign fc_exclude_product = false
  if product != blank
    assign fc_handle = product.handle | downcase
  elsif handle != blank
    assign fc_handle = handle | downcase
  else
    assign fc_handle = ''
  endif

  if fc_handle contains 'sonara-ufm1-test'
    assign fc_exclude_product = true
  endif

  comment
    Hako Studio: staged on dev theme only. Same catalog is shared with live;
    hide from shop/search overlays unless this theme is development/unpublished
    or "Show Hako Studio on shop (public)" is enabled in theme settings.
  endcomment
  if fc_handle contains 'hako-studio-'
    assign fc_show_hako_studio = false
    if theme.role == 'development' or theme.role == 'unpublished'
      assign fc_show_hako_studio = true
    endif
    if settings.fc_show_hako_studio_in_shop
      assign fc_show_hako_studio = true
    endif
    unless fc_show_hako_studio
      assign fc_exclude_product = true
    endunless
  endif
-%}
