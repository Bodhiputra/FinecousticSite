{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign media_count = product.media.size
  assign is_available = variant.available

  if section.settings.description != blank
    assign pdp_description = section.settings.description
  else
    assign pdp_description = product.description | split: '<ul' | first | split: '<UL' | first
  endif

  assign has_color = false
  assign color_option_pos = 0
  for option in product.options
    assign option_down = option | downcase
    if option_down == 'color' or option_down == 'colour'
      assign has_color = true
      assign color_option_pos = forloop.index0
    endif
  endfor

  assign fc_variant_gallery = false
  if section.settings.variant_image_gallery
    assign fc_variant_gallery = true
  endif
  if product.handle == 'groove-ows-ft21'
    assign fc_variant_gallery = true
  endif
  if fc_variant_gallery == false and has_color
    assign fc_variant_image_count = 0
    for v in product.variants
      if v.featured_media or v.image
        assign fc_variant_image_count = fc_variant_image_count | plus: 1
      endif
    endfor
    if fc_variant_image_count > 1
      assign fc_variant_gallery = true
    elsif fc_variant_image_count > 0 and media_count <= 1
      assign fc_variant_gallery = true
    endif
  endif

  assign hero_image = product.featured_image
  if variant.featured_media
    assign hero_image = variant.featured_media.preview_image
  elsif variant.image
    assign hero_image = variant.image
  endif

  assign fc_desktop_stack = section.settings.desktop_stacked_layout
  if product.handle == 'groove-anc-ft20'
    assign fc_desktop_stack = true
  endif
-%}

{%- render 'fc-product-data', product: product -%}

<section
  class="fc-pdp-u fc-pdp-hero{% if fc_desktop_stack %} fc-pdp-u--desktop-stack{% endif %}"
  id="fc-pdp-u-{{ section.id }}"
  data-section-id="{{ section.id }}"
  {% if fc_desktop_stack %}data-fc-desktop-stack="true"{% endif %}
>
  <div class="fc-pdp-u__inner">
    <div class="fc-pdp-u__hero">
      <div class="fc-pdp-u__visual">
        <div
          class="fc-pdp-u__gallery{% if fc_variant_gallery %} fc-pdp-u__gallery--variant{% endif %}{% if fc_desktop_stack %} fc-pdp-u__gallery--desktop-vertical{% endif %}"
          data-fc-pdp-gallery
          {% if fc_variant_gallery %}data-fc-variant-gallery{% endif %}
        >
          <div class="fc-pdp-u__slides">
            {%- if fc_variant_gallery -%}
              <div class="fc-pdp-u__slide is-active" data-fc-variant-slide>
                {%- if hero_image -%}
                  {{ hero_image | image_url: width: 1200 | image_tag:
                    class: 'fc-pdp-u__slide-media',
                    loading: 'eager',
                    sizes: '(min-width: 990px) 640px, 92vw',
                    widths: '600, 800, 1000, 1200',
                    alt: variant.title | default: product.title | escape
                  }}
                {%- endif -%}
              </div>
            {%- elsif media_count > 0 -%}
              {%- for media in product.media -%}
                {%- liquid
                  if forloop.first
                    assign fc_slide_preload = 'metadata'
                    assign fc_slide_loading = 'eager'
                    assign fc_slide_fetchpriority = 'high'
                  else
                    assign fc_slide_preload = 'none'
                    assign fc_slide_loading = 'lazy'
                    assign fc_slide_fetchpriority = 'low'
                  endif
                -%}
                <div class="fc-pdp-u__slide{% if forloop.first %} is-active{% endif %}" data-slide-index="{{ forloop.index0 }}">
                  {%- if media.media_type == 'video' -%}
                    {{ media | video_tag:
                      class: 'fc-pdp-u__slide-media',
                      autoplay: false,
                      loop: true,
                      muted: true,
                      playsinline: true,
                      controls: false,
                      preload: fc_slide_preload
                    }}
                  {%- else -%}
                    {{ media | image_url: width: 1200 | image_tag:
                      class: 'fc-pdp-u__slide-media',
                      loading: fc_slide_loading,
                      fetchpriority: fc_slide_fetchpriority,
                      sizes: '(min-width: 990px) 640px, 92vw',
                      widths: '600, 800, 1000, 1200',
                      alt: media.alt | default: product.title | escape
                    }}
                  {%- endif -%}
                </div>
              {%- endfor -%}
            {%- elsif product.featured_image -%}
              <div class="fc-pdp-u__slide is-active" data-slide-index="0">
                {{ product.featured_image | image_url: width: 1200 | image_tag:
                  class: 'fc-pdp-u__slide-media',
                  loading: 'eager',
                  alt: product.title | escape
                }}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>

      <div class="fc-pdp-u__meta">
        <div class="fc-pdp-u__meta-center">
        <h1 class="fc-pdp-u__title">{{ product.title | escape }}</h1>

        {%- if pdp_description != blank -%}
          <div class="fc-pdp-u__description">{{ pdp_description | escape }}</div>
        {%- endif -%}

        {%- unless product.has_only_default_variant -%}
          <div class="fc-pdp-u__variants" data-fc-pdp-variants>
            <span class="fc-pdp-u__variants-label">{{ product.options[0] | default: 'Option' | downcase | capitalize }}</span>
            <div class="fc-pdp-u__variant-list">
              {%- for v in product.variants -%}
                {%- liquid
                  assign v_hero = null
                  if v.featured_media
                    assign v_hero = v.featured_media.preview_image
                  elsif v.image
                    assign v_hero = v.image
                  endif
                -%}
                <button
                  type="button"
                  class="fc-pdp-u__variant{% if v.id == variant.id %} is-selected{% endif %}{% unless v.available %} is-unavailable{% endunless %}"
                  data-variant-id="{{ v.id }}"
                  data-variant-price="{{ v.price | money | escape }}"
                  data-variant-available="{% if v.available %}true{% else %}false{% endif %}"
                  {% if v_hero %}data-variant-image="{{ v_hero | image_url: width: 1200 }}"{% endif %}
                  aria-pressed="{% if v.id == variant.id %}true{% else %}false{% endif %}"
                >
                  {{ v.title | downcase | capitalize }}
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endunless -%}

        <div class="fc-pdp-u__buy" data-fc-pdp-purchase>
          <button
            type="button"
            class="fc-pdp-u__atc{% unless is_available %} is-oos{% endunless %}"
            data-variant-id="{{ variant.id }}"
            {% unless is_available %}disabled aria-disabled="true"{% endunless %}
          >
            <span class="fc-pdp-u__atc-price" data-fc-pdp-price>
              {%- if product.price_varies -%}<span class="fc-pdp-u__price-from">From</span> {%- endif -%}
              {{ variant.price | money }}
            </span>
            <span class="fc-pdp-u__atc-sep" aria-hidden="true">·</span>
            <span class="fc-pdp-u__atc-label" data-fc-pdp-atc-label>{% if is_available %}Add to bag{% else %}Sold Out{% endif %}</span>
          </button>
        </div>

        {%- if fc_desktop_stack -%}
          <div class="fc-pdp-u__meta-accordions" data-fc-desktop-accordions></div>
        {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

<div class="fc-pdp-u__dock" id="fc-pdp-u-dock-{{ section.id }}" hidden>
  <button
    type="button"
    class="fc-pdp-u__atc fc-pdp-u__atc--dock{% unless is_available %} is-oos{% endunless %}"
    data-variant-id="{{ variant.id }}"
    {% unless is_available %}disabled aria-disabled="true"{% endunless %}
  >
    <span class="fc-pdp-u__atc-price" data-fc-pdp-price>
      {%- if product.price_varies -%}<span class="fc-pdp-u__price-from">From</span> {%- endif -%}
      {{ variant.price | money }}
    </span>
    <span class="fc-pdp-u__atc-sep" aria-hidden="true">·</span>
    <span class="fc-pdp-u__atc-label" data-fc-pdp-atc-label>{% if is_available %}Add to bag{% else %}Sold Out{% endif %}</span>
  </button>
</div>

{% stylesheet %}
.fc-pdp-u {
  padding: 0;
}

.fc-pdp-u.fc-pdp-hero {
  box-sizing: border-box;
  padding-top: 48px;
}

.fc-pdp-u__inner {
  width: min(1280px, 96vw);
  max-width: none;
  margin: 0 auto;
  padding: 0 clamp(20px, 4vw, 48px);
  box-sizing: border-box;
}

.fc-pdp-u__hero {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(32px, 5vw, 72px);
  align-items: center;
  min-height: min(72vh, 720px);
}

.fc-pdp-u__visual {
  width: 100%;
  min-width: 0;
  min-height: min(65vh, 620px);
}

.fc-pdp-u__gallery {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: min(62vh, 600px);
}

.fc-pdp-u__slides {
  position: relative;
  flex: 1 1 auto;
  width: 100%;
  min-height: min(60vh, 580px);
  overflow: hidden;
}

.fc-pdp-u__slides .fc-ig-track {
  min-height: inherit;
}

.fc-pdp-u__slide {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: min(60vh, 580px);
}

.fc-pdp-u__slide.is-active {
  opacity: 1;
  padding-top: 0;
  padding-bottom: 0;
}

.fc-pdp-u__slide-media {
  max-width: 100%;
  max-height: min(58vh, 560px);
  width: auto;
  height: auto;
  object-fit: contain;
  display: block;
}

.fc-pdp-u__gallery--variant .fc-pdp-u__slides {
  overflow: visible;
}

.fc-pdp-u__gallery--variant .fc-ig-dots,
.fc-pdp-u__gallery--variant.fc-ig-viewport > .fc-ig-dots {
  display: none !important;
}

.fc-pdp-u__meta {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  width: 100%;
  min-width: 0;
}

.fc-pdp-u__title {
  font-family: var(--fc-font);
  font-size: clamp(28px, 4.5vw, 52px);
  font-weight: 700;
  line-height: 0.95;
  letter-spacing: -0.02em;
  color: #ffffff;
  margin: 0 0 12px;
}

.fc-pdp-u__price-from {
  margin-right: 4px;
}

.fc-pdp-u__description {
  font-family: var(--fc-font);
  font-size: clamp(15px, 1.65vw, 18px);
  font-weight: 500;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.72);
  margin: 0 0 20px;
  max-width: min(560px, 100%);
}

.fc-pdp-u__variants {
  margin-bottom: 20px;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.fc-pdp-u__variants-label {
  display: block;
  font-family: var(--fc-font);
  font-size: 10px;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.45);
  margin-bottom: 10px;
}

.fc-pdp-u__variant-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  gap: 8px;
}

.fc-pdp-u__variant {
  font-family: var(--fc-font);
  font-size: 12px;
  font-weight: 600;
  padding: 10px 14px;
  border: 1px solid rgba(255, 255, 255, 0.2);
  background: transparent;
  color: rgba(255, 255, 255, 0.7);
  cursor: pointer;
}

.fc-pdp-u__variant.is-selected {
  border-color: var(--fc-yellow);
  color: #ffffff;
}

.fc-pdp-u__variant.is-unavailable {
  opacity: 0.55;
}

.fc-pdp-u__variant.is-disabled,
.fc-pdp-u__variant:disabled {
  opacity: 0.35;
  cursor: not-allowed;
}

.fc-pdp-u__buy {
  display: flex;
  justify-content: flex-start;
  width: 100%;
  max-width: min(560px, 100%);
}

.fc-pdp-u__atc {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.35em;
  font-family: var(--fc-font);
  font-size: clamp(14px, 1.2vw, 16px);
  font-weight: 700;
  letter-spacing: -0.01em;
  color: #121212;
  background: var(--fc-yellow);
  border: none;
  border-radius: 3px;
  padding: 16px 32px;
  min-height: 48px;
  min-width: 200px;
  width: 100%;
  cursor: pointer;
  transition: opacity 0.15s ease;
}

@media (hover: hover) {
  .fc-pdp-u__atc:hover:not(:disabled) {
    opacity: 0.85;
  }
}

.fc-pdp-u__atc.is-oos,
.fc-pdp-u__atc:disabled {
  opacity: 0.72;
  cursor: not-allowed;
}

.fc-pdp-u__atc-sep {
  opacity: 0.55;
}

.fc-pdp-u__oos {
  font-family: var(--fc-font);
  font-size: 13px;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.45);
  margin: 0;
}

.fc-pdp-u__oos--dock {
  padding: 12px 16px;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 3px;
  text-align: center;
  width: min(100%, 320px);
}

.fc-pdp-u__dock {
  display: none;
}

.fc-pdp-u__meta-accordions {
  display: none;
  width: 100%;
}

@media screen and (min-width: 990px) {
  .fc-pdp-u.fc-pdp-hero {
    padding-top: var(--fc-nav-clearance);
  }

  .fc-pdp-u.fc-pdp-hero .fc-pdp-u__inner {
    width: 100%;
    max-width: none;
    margin-left: 0;
    margin-right: 0;
    padding-left: 24px;
    padding-right: 24px;
  }

  .fc-pdp-u--desktop-stack .fc-pdp-u__hero {
    align-items: flex-start;
    min-height: 0;
  }

  .fc-pdp-u--desktop-stack .fc-pdp-u__visual {
    min-height: 0;
    align-self: start;
    position: relative;
    top: auto;
    overflow: visible;
  }

  .fc-pdp-u--desktop-stack .fc-pdp-u__gallery--desktop-vertical {
    align-items: stretch;
    min-height: 0;
    height: auto;
  }

  /* Page scroll drives images (no inner scrollbar); video section follows hero */
  .fc-pdp-u--desktop-stack .fc-pdp-u__gallery--desktop-vertical .fc-pdp-u__slides {
    display: flex;
    flex-direction: column;
    gap: 0;
    overflow: visible;
    max-height: none;
    min-height: 0;
    height: auto;
    position: static;
    touch-action: auto;
    cursor: default;
  }

  .fc-pdp-u--desktop-stack .fc-pdp-u__gallery--desktop-vertical .fc-pdp-u__slides.fc-ig-viewport {
    overflow: visible;
    touch-action: auto;
    cursor: default;
  }

  .fc-pdp-u--desktop-stack .fc-pdp-u__gallery--desktop-vertical .fc-ig-track {
    display: contents;
    transform: none !important;
    height: auto;
  }

  .fc-pdp-u--desktop-stack .fc-pdp-u__gallery--desktop-vertical .fc-pdp-u__slide {
    flex: 0 0 auto;
    box-sizing: border-box;
    min-height: calc(100vh - var(--fc-nav-clearance) - clamp(20px, 3vw, 40px));
    padding: 0;
    opacity: 1;
    scroll-snap-align: start;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fc-pdp-u--desktop-stack .fc-pdp-u__gallery--desktop-vertical .fc-pdp-u__slide-media {
    max-height: min(72vh, 680px);
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .fc-pdp-u--desktop-stack .fc-pdp-u__meta {
    position: sticky;
    top: var(--fc-nav-clearance);
    align-self: start;
    height: auto;
    max-height: none;
    overflow-y: visible;
    overscroll-behavior: auto;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
  }

  .fc-pdp-u--desktop-stack .fc-pdp-u__meta-center {
    width: 100%;
    padding: clamp(20px, 3vw, 40px) 0;
    box-sizing: border-box;
  }

  .fc-pdp-u--desktop-stack .fc-pdp-u__meta-accordions {
    max-width: min(560px, 100%);
  }

  .fc-pdp-u--desktop-stack .fc-pdp-u__meta-accordions {
    display: block;
    margin-top: clamp(16px, 2vw, 24px);
    width: 100%;
  }

  .fc-pdp-u--desktop-stack .fc-pdp-u__meta-accordions .fc-pdp-specs-inbox__inner {
    display: flex;
    flex-direction: column;
    gap: 0;
    width: 100%;
  }

  .fc-pdp-u--desktop-stack .fc-pdp-u__meta-accordions .fc-pdp-acc > .fc-pdp-acc__summary,
  .fc-pdp-u--desktop-stack .fc-pdp-u__meta-accordions .fc-pdp-acc__body,
  .fc-pdp-u--desktop-stack .fc-pdp-u__meta-accordions .fc-pdp-guide-row {
    padding-left: 0;
    padding-right: 0;
  }

  .fc-pdp-u--desktop-stack .fc-pdp-u__meta-accordions .fc-pdp-acc:first-child {
    border-top: none;
  }
}

@media screen and (max-width: 989px) {
  .fc-pdp-u.fc-pdp-hero {
    padding-bottom: clamp(12px, 2.5vw, 16px);
  }

  .fc-pdp-u.fc-pdp-hero .fc-pdp-u__inner {
    width: 100%;
    padding: 0 clamp(16px, 4vw, 24px);
  }

  .fc-pdp-u__hero {
    display: flex;
    flex-direction: column;
    gap: clamp(10px, 2.5vw, 14px);
    align-items: stretch;
    min-height: 0;
  }

  .fc-pdp-u__visual {
    flex: 0 0 auto;
    width: 100%;
    max-width: min(100%, 520px);
    min-height: 0;
    margin: 0 auto;
  }

  .fc-pdp-u__gallery {
    width: 100%;
    min-height: 0;
  }

  .fc-pdp-u__slides {
    position: relative;
    min-height: min(40vh, 400px);
    height: min(40vh, 400px);
  }

  .fc-pdp-u__slides .fc-ig-track {
    min-height: min(40vh, 400px);
    height: min(40vh, 400px);
  }

  .fc-pdp-u__slide {
    min-height: min(40vh, 400px);
    height: min(40vh, 400px);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .fc-pdp-u__slide-media {
    max-height: min(40vh, 400px);
    max-width: 100%;
    width: auto;
    height: auto;
    margin: 0 auto;
    object-fit: contain;
  }

  .fc-pdp-u__meta {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    max-width: none;
    width: 100%;
    margin: 0;
  }

  .fc-pdp-u__title {
    font-size: clamp(20px, 5.2vw, 26px);
    margin: 0 0 6px;
    line-height: 1.05;
  }

  .fc-pdp-u__description {
    font-size: clamp(13px, 3.4vw, 15px);
    line-height: 1.45;
    margin: 0 0 10px;
  }

  .fc-pdp-u__variants {
    margin-bottom: 8px;
  }

  .fc-pdp-u__buy {
    display: flex;
    width: 100%;
    margin-top: 0;
  }

  .fc-pdp-u__atc {
    max-width: none;
    padding: 14px 20px;
    min-height: 44px;
    font-size: clamp(13px, 3.4vw, 15px);
  }

  .fc-pdp-u__dock {
    display: none !important;
  }
}
{% endstylesheet %}

<script src="{{ 'fc-pdp-unified.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "FC PDP — Unified hero",
  "tag": "section",
  "class": "fc-pdp-unified-section",
  "settings": [
    {
      "type": "textarea",
      "id": "description",
      "label": "Product description",
      "info": "Overrides Shopify product description when set."
    },
    {
      "type": "checkbox",
      "id": "variant_image_gallery",
      "label": "Switch hero image by variant",
      "info": "Single product image that updates when a color/variant is selected — no swipe carousel.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "desktop_stacked_layout",
      "label": "Desktop stacked PDP",
      "info": "Desktop only: vertical image scroll, specs and In the box in the hero column. Mobile unchanged.",
      "default": false
    },
  ],
  "presets": [
    {
      "name": "FC PDP — Unified hero"
    }
  ]
}
{% endschema %}
