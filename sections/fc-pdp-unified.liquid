      "info": "e.g. Original"
    },
    {
      "type": "url",
      "id": "sibling_1_url",
      "label": "Sibling 1 URL"
    },
    {
      "type": "text",
      "id": "sibling_2_label",
      "label": "Sibling 2 label",
      "info": "e.g. Large"
    },
    {
      "type": "url",
      "id": "sibling_2_url",
      "label": "Sibling 2 URL"
    },
    {
      "type": "header",
      "content": "Product video"
    },
    {
      "type": "text",
      "id": "video_heading",
      "label": "Video heading"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "text",
      "id": "video_mp4_url",
      "label": "Video MP4 URL",
      "info": "Direct MP4 URL (e.g. Shopify CDN). Used when no uploaded video is set."
    },
    {
      "type": "video_url",
