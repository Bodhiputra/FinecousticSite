{{ 'fc-shop.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
<script src="{{ 'fc-shop-grid.js' | asset_url }}" defer></script>

{%- liquid
  assign fc_heading = section.settings.heading | default: 'Shop Hako Series.'

  assign fc_p302 = section.settings.product_studio_302
  if fc_p302 == blank
    assign fc_p302 = all_products['hako-studio-302']
  endif

  assign fc_p301 = section.settings.product_studio_301
  if fc_p301 == blank
    assign fc_p301 = all_products['hako-studio-301']
  endif

  assign fc_p_nomad_l = section.settings.product_nomad_l
  if fc_p_nomad_l == blank
    assign fc_p_nomad_l = all_products['hako-nomad-l-fbs2']
  endif

  assign fc_p_nomad = section.settings.product_nomad
  if fc_p_nomad == blank
    assign fc_p_nomad = all_products['hako-nomad-fbs1']
  endif
-%}

{%- if fc_p302 != blank -%}
  {%- render 'fc-product-data', product: fc_p302, fc_display_title: 'Hako Studio 302' -%}
{%- endif -%}
{%- if fc_p301 != blank -%}
  {%- render 'fc-product-data', product: fc_p301, fc_display_title: 'Hako Studio 301' -%}
{%- endif -%}
{%- if fc_p_nomad_l != blank -%}
  {%- render 'fc-product-data', product: fc_p_nomad_l, fc_display_title: 'Hako Nomad L' -%}
{%- endif -%}
{%- if fc_p_nomad != blank -%}
  {%- render 'fc-product-data', product: fc_p_nomad, fc_display_title: 'Hako Nomad' -%}
{%- endif -%}

<section
  class="fc-home-hako-series"
  id="fc-home-hako-series-{{ section.id }}"
  aria-labelledby="fc-home-hako-series-title-{{ section.id }}"
  style="--fc-home-hako-series-list-y: {{ section.settings.content_anchor_y }}%;"
>
  {%- if fc_heading != blank -%}
    <h2
      class="fc-home-hako-series__title fc-nav-clearance--section-title"
      id="fc-home-hako-series-title-{{ section.id }}"
    >
      {{ fc_heading | escape }}
    </h2>
  {%- endif -%}

  <div class="fc-home-hako-series__grid-wrap">
    <div class="fc-grid fc-home-hako-series__grid" data-cols="4">
      {%- render 'fc-shop-card', product: fc_p302, eager_image: true, curated: true -%}
      {%- render 'fc-shop-card', product: fc_p301, eager_image: true, curated: true -%}
      {%- render 'fc-shop-card', product: fc_p_nomad_l, eager_image: true, curated: true -%}
      {%- render 'fc-shop-card', product: fc_p_nomad, eager_image: true, curated: true -%}
    </div>
  </div>
</section>

{% stylesheet %}
.fc-home-hako-series-section.shopify-section {
  width: 100%;
  max-width: none;
  min-height: 100svh;
  min-height: 100dvh;
  padding: 0;
  margin: 0;
  background: #000;
}

.fc-home-hako-series {
  box-sizing: border-box;
  position: relative;
  width: 100%;
  min-height: 100svh;
  min-height: 100dvh;
  padding: 0;
  background: #000;
  overflow: hidden;
}

/* Product row anchor: vertical center of the list sits at --fc-home-hako-series-list-y (default 52%). */
.fc-home-hako-series__grid-wrap {
  position: absolute;
  left: 0;
  right: 0;
  top: var(--fc-home-hako-series-list-y, 52%);
  transform: translateY(-50%);
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  padding: 0 var(--fc-page-gutter, clamp(16px, 4vw, 64px));
  box-sizing: border-box;
  pointer-events: none;
}

.fc-home-hako-series__grid-wrap .fc-home-hako-series__grid {
  pointer-events: auto;
}

.fc-home-hako-series__title {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1;
  width: 100%;
  margin: 0;
  padding-left: var(--fc-page-gutter, clamp(16px, 4vw, 64px));
  padding-right: var(--fc-page-gutter, clamp(16px, 4vw, 64px));
  padding-bottom: 0;
  box-sizing: border-box;
  text-align: center;
  font-family: var(--fc-font, sans-serif);
  font-size: clamp(26px, 3.33vw, 48px);
  font-weight: 700;
  letter-spacing: -0.07em;
  line-height: 1.05;
  color: #fff;
}

.fc-home-hako-series__grid.fc-grid {
  --fc-product-cols: 4;
  --fc-max-cols: 4;
  --fc-tag-max-w: 100%;
  width: fit-content;
  max-width: 100%;
  margin: 0;
  padding: 0;
  justify-content: center;
  justify-items: stretch;
}

@media screen and (min-width: 750px) {
  .fc-home-hako-series__grid.fc-grid {
    --fc-max-cols: 4;
  }
}

.fc-home-hako-series__grid .fc-card {
  width: min(280px, 100%);
  border: none;
  outline: none;
  box-shadow: none;
  background: transparent;
}

.fc-home-hako-series__grid .fc-card__image {
  border: none;
  outline: none;
  box-shadow: none;
  background: transparent;
}

.fc-home-hako-series__grid .fc-card__tag,
.fc-home-hako-series__grid .fc-tag-oos-wrap {
  width: 100%;
  max-width: 100%;
}

.fc-home-hako-series__grid .fc-card__tag.fc-tag--coming-soon {
  width: 100%;
  max-width: 100%;
}

.fc-home-hako-series__grid .fc-card__name,
.fc-home-hako-series__grid .fc-card__price {
  overflow: hidden;
  text-overflow: ellipsis;
}

.fc-home-hako-series__grid .fc-card[data-category='speakers'] .fc-card__img {
  object-fit: contain;
}

@media screen and (max-width: 749px) {
  .fc-home-hako-series__grid-wrap {
    top: max(var(--fc-home-hako-series-list-y, 52%), calc(var(--fc-nav-clearance, 72px) + 140px));
  }

  .fc-home-hako-series__grid.fc-grid {
    --fc-max-cols: 2;
    width: fit-content;
    max-width: min(100%, calc(2 * 280px + clamp(16px, 3vw, 50px)));
  }

  .fc-home-hako-series__grid .fc-card {
    width: min(280px, 100%);
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Home Shop Hako Series",
  "tag": "section",
  "class": "fc-home-hako-series-section fc-section--flush-top",
  "settings": [
    {
      "type": "paragraph",
      "content": "Curated shop row for the homepage (Figma Shop Hako Series). Uses the same product cards and yellow tags as the main shop."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop Hako Series."
    },
    {
      "type": "range",
      "id": "content_anchor_y",
      "label": "Product row vertical position",
      "min": 28,
      "max": 62,
      "step": 1,
      "unit": "%",
      "default": 52,
      "info": "Vertical center of the four-card row from the top of the viewport (not the heading)."
    },
    {
      "type": "header",
      "content": "Products (left to right)"
    },
    {
      "type": "product",
      "id": "product_studio_302",
      "label": "Hako Studio 302"
    },
    {
      "type": "product",
      "id": "product_studio_301",
      "label": "Hako Studio 301"
    },
    {
      "type": "product",
      "id": "product_nomad_l",
      "label": "Hako Nomad L"
    },
    {
      "type": "product",
      "id": "product_nomad",
      "label": "Hako Nomad"
    }
  ],
  "presets": [
    {
      "name": "Home Shop Hako Series"
    }
  ]
}
{% endschema %}
