{%- liquid
  assign fc_alt = section.settings.alt | default: 'Hako Studio 301'
  assign fc_bg = section.settings.background_image
  assign fc_bg_asset = section.settings.background_asset | strip
  if fc_bg_asset == blank and fc_bg == blank
    assign fc_bg_asset = 'hako-studio-301-hero-withbg.png'
  endif
-%}

{%- if section.settings.hide_section -%}
  <style>
    #shopify-section-{{ section.id }} {
      display: none !important;
    }
  </style>
{%- else -%}

<section
  class="fc-pdp-studio-blank{% if fc_bg != blank or fc_bg_asset != blank %} fc-pdp-studio-blank--has-image{% endif %}"
  id="fc-pdp-studio-blank-{{ section.id }}"
  data-section-id="{{ section.id }}"
  aria-label="{{ fc_alt | escape }}"
  style="--fc-pdp-studio-blank-min-h: {{ section.settings.min_height_vh }}svh; --fc-pdp-studio-blank-bg-pos-x: {{ section.settings.background_position_x }}%; --fc-pdp-studio-blank-bg-pos-y: {{ section.settings.background_position_y }}%; --fc-pdp-studio-blank-title-pt: {{ section.settings.title_padding_top }}px; --fc-pdp-studio-blank-title-pl: {{ section.settings.title_padding_left }}px; --fc-pdp-studio-blank-title-pr: {{ section.settings.title_padding_right }}px; background-color: {{ section.settings.background_color }};"
>
  {%- if fc_bg != blank -%}
    {{
      fc_bg
      | image_url: width: 3840
      | image_tag:
        loading: 'eager',
        fetchpriority: 'high',
        sizes: '100vw',
        widths: '800, 1200, 1600, 2048, 2560, 3200, 3840',
        alt: fc_alt,
        class: 'fc-pdp-studio-blank__bg'
    }}
  {%- elsif fc_bg_asset != blank -%}
    <img
      class="fc-pdp-studio-blank__bg"
      src="{{ fc_bg_asset | asset_url }}"
      alt="{{ fc_alt | escape }}"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      width="4320"
      height="2700"
    >
  {%- endif -%}

  {%- liquid
    assign fc_title_left = section.settings.title_left | strip
    assign fc_title_right = section.settings.title_right | strip
    assign fc_title = section.settings.title | strip
    assign fc_title_a11y = section.settings.title_accessible | strip
    if fc_title_a11y == blank
      if fc_title_left != blank and fc_title_right != blank
        assign fc_title_a11y = fc_title_left | append: ' ' | append: fc_title_right
      else
        assign fc_title_a11y = fc_title
      endif
    endif
  -%}
  {%- if fc_title_left != blank or fc_title_right != blank -%}
    <div class="fc-pdp-studio-blank__title-wrap">
      <h2 class="fc-pdp-studio-blank__title fc-pdp-studio-blank__title--split" aria-label="{{ fc_title_a11y | escape }}">
        {%- if fc_title_left != blank -%}
          <span class="fc-pdp-studio-blank__title-part fc-pdp-studio-blank__title-part--start">{{ fc_title_left | escape }}</span>
        {%- endif -%}
        {%- if fc_title_right != blank -%}
          <span class="fc-pdp-studio-blank__title-part fc-pdp-studio-blank__title-part--end">{{ fc_title_right | escape }}</span>
        {%- endif -%}
      </h2>
    </div>
  {%- elsif fc_title != blank -%}
    <div class="fc-pdp-studio-blank__title-wrap">
      <h2 class="fc-pdp-studio-blank__title">{{ fc_title | escape }}</h2>
    </div>
  {%- endif -%}
</section>

{%- endif -%}

{% stylesheet %}
.fc-pdp-studio-blank-section {
  width: 100%;
  max-width: none;
  padding: 0;
  margin: 0;
}

.fc-pdp-studio-blank {
  box-sizing: border-box;
  position: relative;
  display: block;
  width: 100vw;
  max-width: 100vw;
  margin-left: calc(50% - 50vw);
  margin-right: calc(50% - 50vw);
  min-height: var(--fc-pdp-studio-blank-min-h, 100svh);
  min-height: var(--fc-pdp-studio-blank-min-h, 100dvh);
  padding: 0;
  overflow: hidden;
}

.fc-pdp-studio-blank--has-image {
  height: var(--fc-pdp-studio-blank-min-h, 100svh);
  height: var(--fc-pdp-studio-blank-min-h, 100dvh);
}

.fc-pdp-studio-blank__bg {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: var(--fc-pdp-studio-blank-bg-pos-x, 50%) var(--fc-pdp-studio-blank-bg-pos-y, 50%);
}

.fc-pdp-studio-blank__title-wrap {
  position: absolute;
  inset: 0;
  z-index: 1;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  padding-left: var(--fc-pdp-studio-blank-title-pl, 150px);
  padding-right: var(--fc-pdp-studio-blank-title-pr, 180px);
  pointer-events: none;
}

.fc-pdp-studio-blank__title {
  margin: 0;
  width: 100%;
  max-width: 100%;
  font-family: var(--fc-font, inherit);
  font-size: 96px;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -0.07em;
  text-align: center;
  color: #fff;
}

.fc-pdp-studio-blank__title--split {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  text-align: initial;
}

.fc-pdp-studio-blank__title-part {
  flex: 0 1 auto;
  min-width: 0;
}

.fc-pdp-studio-blank__title-part--start {
  margin-right: auto;
  text-align: left;
}

.fc-pdp-studio-blank__title-part--end {
  margin-left: auto;
  text-align: right;
}
{% endstylesheet %}

{% schema %}
{
  "name": "FC PDP — Studio blank",
  "tag": "section",
  "class": "fc-pdp-studio-blank-section fc-section--flush-top",
  "settings": [
    {
      "type": "paragraph",
      "content": "Full-viewport hero above the catalog. Image uses object-fit: cover."
    },
    {
      "type": "checkbox",
      "id": "hide_section",
      "label": "Hide hero section",
      "default": true,
      "info": "Temporarily removes the full-viewport hero (background + title) from the page. Also remove this section from the product template order if it should stay off."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image (optional — overrides theme asset)"
    },
    {
      "type": "text",
      "id": "background_asset",
      "label": "Background theme asset",
      "default": "hako-studio-301-hero-withbg.png"
    },
    {
      "type": "range",
      "id": "background_position_x",
      "label": "Background focus — horizontal (object-position X)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 50,
      "info": "With object-fit: cover, moves which part of the image stays visible left ↔ right. 50% = centered."
    },
    {
      "type": "range",
      "id": "background_position_y",
      "label": "Background focus — vertical (object-position Y)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 80,
      "info": "Moves visible area up ↔ down. Lower % shows more of the top; higher % shows more of the bottom."
    },
    {
      "type": "text",
      "id": "title_left",
      "label": "Title — left (start)",
      "default": "Studio"
    },
    {
      "type": "text",
      "id": "title_right",
      "label": "Title — right (end)",
      "default": "301"
    },
    {
      "type": "text",
      "id": "title_accessible",
      "label": "Accessible title (screen readers)",
      "default": "Hako Studio 301",
      "info": "Optional. Defaults to left + right when split."
    },
    {
      "type": "range",
      "id": "title_padding_top",
      "label": "Title padding top",
      "min": 0,
      "max": 400,
      "step": 4,
      "unit": "px",
      "default": 128
    },
    {
      "type": "range",
      "id": "title_padding_left",
      "label": "Title padding left",
      "min": 0,
      "max": 240,
      "step": 5,
      "unit": "px",
      "default": 150,
      "info": "Shopify range: step 5px (150, 155, …). Max 48 steps to 240."
    },
    {
      "type": "range",
      "id": "title_padding_right",
      "label": "Title padding right",
      "min": 0,
      "max": 240,
      "step": 5,
      "unit": "px",
      "default": 180,
      "info": "Shopify range: step 5px (180, 185, …). Max 48 steps to 240."
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Background alt text",
      "default": "Hako Studio 301"
    },
    {
      "type": "range",
      "id": "min_height_vh",
      "label": "Minimum height (vh)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 100
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background (letterbox fallback)",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "FC PDP — Studio blank"
    }
  ]
}
{% endschema %}
